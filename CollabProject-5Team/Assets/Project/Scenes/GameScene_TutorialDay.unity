--- !u!114 &4862096933974159238
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1472952086167307353}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f150a4f9e071b4f4b9fde87b59246221, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  visualMode: 0
  _fadeGroupObj: {fileID: 7238501849925591872}
  _fadeCanvasGroup: {fileID: 627951143336880841}
  _clockGroupObj: {fileID: 7171178922467056058}
  _clockFillImage: {fileID: 8697294988686898840}
  _nightGroupObj: {fileID: 961884365744395760}
  _nightFillImage: {fileID: 6389332419128857901}
  _slidePopupGroupObj: {fileID: 1806973119668898852}
  _slidePopupRect: {fileID: 5391978643095100432}
  _slidePopupCanvasGroup: {fileID: 1210834567800036442}
  fadeDurationSeconds: 0.16
  visibleDurationSeconds: 0.49
  slideDuration: 1
  slideVisibleDuration: 2
  startXPosition: -200
  targetXPosition: 300
  _dailyComment: {fileID: 4302782477001662962}
  _dayMessageDatas:
  - dayOfWeek: 0
    randomMessage:
    - "\uC6D4\uC694\uC77C \uC88B\uC544~"
    - "\uC8FC\uB9D0 \uC5B4\uB514 \uAC14\uC5B4?\\n\uB204\uAC00 \uB0B4 \uC8FC\uB9D0
      \uC0AD\uC81C\uD588\uB0D0."
    - "\uC77C\uB2E8 \uCEE4\uD53C\uBD80\uD130 \uC218\uD608\uD558\uC790\\n\uC0B4\uAE30
      \uC704\uD574\uC11C."
    - "\uCD9C\uADFC\uD588\uB294\uB370 \uBC8C\uC368 \uD1F4\uADFC\uD558\uACE0 \uC2F6\uB2E4."
    - "\uC774\uBC88 \uC8FC\uB294 \uC9C4\uC9DC\\n\uC54C\uCC28\uAC8C \uBCF4\uB0B4\uBCF4\uC790(\uC791\uC2EC\uC0BC\uBD84)."
  - dayOfWeek: 1
    randomMessage:
    - "\uC6D4\uC694\uC77C\uC774\\n\uB450 \uBC88 \uC788\uB294 \uAE30\uBD84\uC774\uC57C."
    - "\uC774\uBC88 \uC8FC\uB294 \uC65C \uC774\uB807\uAC8C \uAE38\uC9C0?"
    - "\uC544\uC9C1 \uD654\uC694\uC77C\uC774\uB77C\uACE0?\\n\uAC70\uC9D3\uB9D0 \uD558\uC9C0
      \uB9C8."
    - "\uD560 \uC77C\uC740 \uD0DC\uC0B0\uC778\uB370 \uC2DC\uAC04\uC740 \uAC70\uAFB8\uB85C
      \uAC00\uB294 \uB290\uB08C."
    - "\uBAB8\uB3C4 \uB9C8\uC74C\uB3C4 \uC544\uC9C1 \uC8FC\uB9D0\uC5D0 \uBA38\uBB3C\uB7EC
      \uC788\uB294 \uC911."
  - dayOfWeek: 2
    randomMessage:
    - "\uC5B8\uC81C\uAE4C\uC9C0 \uD574\uC57C \uB418\uC9C0?\\n(\uB05D\uC774 \uC548
      \uBCF4\uC5EC)"
    - "\uC624\uB298\uB9CC \uC9C0\uB098\uBA74 \uB0B4\uB9AC\uB9C9\uAE38\uC774\uB2E4."
    - "\uBC18 \uC654\uB2E4, \uBC18\uB9CC \uB354 \uBC84\uD2F0\uC790."
    - "\uC0DD\uAC01\uBCF4\uB2E4 \uC2DC\uAC04\uC774 \uC548 \uAC00\uC11C \uB2F9\uD669\uC2A4\uB7EC\uC6C0."
    - "\uC218\uC694\uBCD1 \uB3C4\uC9D0\\n\uC601\uD63C\uC774 \uD138\uB9AC\uB294 \uC911."
  - dayOfWeek: 3
    randomMessage:
    - "\uC9C4\uC9DC \uC8FD\uACA0\uB2E4,\\n\uB108\uBB34 \uD53C\uACE4\uD574."
    - "\uBAA9\uC694\uC77C\uC740 \uAE08\uC694\uC77C\uC758 \uD504\uB9AC\uBDF0\uC77C
      \uBFD0."
    - "\uC774\uC81C \uC5D0\uB108\uC9C0 \uAC8C\uC774\uC9C0\uAC00 \uBC14\uB2E5\uB0AC\uB2E4."
    - "\uB0B4\uC77C \uD1F4\uADFC\uD560 \uC0DD\uAC01\uB9CC \uD558\uBA70 \uBC84\uD2F0\uB294
      \uC911."
    - "\uB354 \uC774\uC0C1 \uC544\uBB34\uAC83\uB3C4\\n\uB208\uC5D0 \uB4E4\uC5B4\uC624\uC9C0
      \uC54A\uB294\uB2E4."
  - dayOfWeek: 4
    randomMessage:
    - "\uC624\uB298\uB9CC \uBC84\uD2F0\uC790!\\n\uB4DC\uB514\uC5B4 \uB05D\uC774 \uBCF4\uC778\uB2E4."
    - "\uB0B4\uC77C \uB2A6\uC7A0 \uC798 \uC0DD\uAC01\uC5D0 \uBC8C\uC368 \uD589\uBCF5\uD568."
    - "\uAE08\uC694\uC77C \uD1F4\uADFC\uAE38\uC740 \uC138\uC0C1\uC5D0\uC11C \uAC00\uC7A5
      \uC544\uB984\uB2E4\uC6B4 \uAE38."
    - "\uC624\uD6C4 4\uC2DC\uBD80\uD130 \uC774\uBBF8 \uB9C8\uC74C\uC740 \uD1F4\uADFC
      \uC644\uB8CC."
    - "\uC774\uBC88 \uC8FC\uB3C4 \uC0B4\uC544\uB0A8\uC558\uB2E4,\\n\uB098 \uC790\uC2E0
      \uACE0\uC0DD\uD588\uB2E4!"
