  title: "\uAC8C\uC784 \uD68C\uC0AC \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974 \uC81C\uC548\uC11C"
  trait: 34
  startRepo: 1
  grade: 1
  role: 1
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uC720\uC800\uAC00 \uB9CC\uB4E4\uACE0\uC2F6\uC740
    \uAC8C\uC784\uC744 \uB9CC\uB4E4\uBA74\uC11C \uAC8C\uC784 \uD68C\uC0AC\uB97C \uD0A4\uC6CC\uB098\uAC00\uB294
    \uACBD\uC601 \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974 \uC81C\uC548. \\n <b>\uAE30\uB300
    \uD6A8\uACFC</b> \\n \uAC8C\uC784 \uC81C\uC791, \uD68C\uC0AC \uACBD\uC601 \uB4F1
    \uB2E4\uC591\uD55C \uCF58\uD150\uCE20\uB97C \uC990\uAE38 \uC218 \uC788\uB294
    \uAC8C\uC784\uC774 \uB420\uAC81\uB2C8\uB2E4. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b>
    \\n \uC591\uCABD\uC758 \uBC38\uB7F0\uC2A4\uB97C \uC798 \uC7A1\uC9C0 \uC54A\uC73C\uBA74
    \uC5B4\uC911\uAC04\uD55C \uAC8C\uC784\uC774 \uB418\uC5B4\uBC84\uB9BD\uB2C8\uB2E4.
    \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uACE0\uC6A9\uD560 \uC218 \uC788\uB294 \uC9C1\uC6D0\uC744
    \uACE0\uC591\uC774\uB098 \uACF0\uC73C\uB85C \uD558\uBA74 \uADC0\uC5EC\uC6B8 \uAC83
    \uAC19\uC2B5\uB2C8\uB2E4! \\n"
  uiCategory: "\uC2DC\uBBAC\uB808\uC774\uC158"
