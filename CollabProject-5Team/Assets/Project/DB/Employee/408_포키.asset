  fireText: "\uC9C4\uC9DC \uC800 \uC790\uB974\uC2E4 \uAC70\uC5D0\uC694?\u314B"
  fireText2: "\uC640, \uC9C4\uC9DC \uD574\uACE0\uB77C\uB2C8 \uC644\uC804 \uC5B4\uC774\uC5C6\uB124\uC6A9!
    \uD788\uB4E0 \uB4DC\uB9BD \uC9C0\uC6B8 \uC0DD\uAC01\uC5D0 \uD0B9\uBC1B\uC744\uB4EF\uC694~\u314B"
  selfLeftText: "\uD1F4\uC0AC\uD569\uB2C8\uB2E4~\u314B\\n\uC774\uC2A4\uD130\uC5D0\uADF8\uB97C
