  style: "\uC2E0\uC785"
  hireText: "\uC548\uB155\uD558\uC138\uC694~ \uAC8C\uC784\uC5D0 \uB9E4\uC6B4\uB9DB\uACFC
    \uD0B9\uBC1B\uB294 \uC774\uC2A4\uD130 \uC5D0\uADF8\uB97C \uB4EC\uBFCD \uBFCC\uB824\uC904
