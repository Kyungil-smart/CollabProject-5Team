  style: "\uC7AC\uB2A5\uC788\uB294"
  hireText: "\uD5C8\uD5C8, \uC80A\uC740 \uC0AC\uC7A5\uB2D8! 20\uB144 \uACBD\uB825\uC758
    \uD2BC\uD2BC\uD55C \uCF54\uB529 \uAE30\uC220\uB85C \uD68C\uC0AC\uC758 \uB300\uB4E4\uBCF4\uAC00
