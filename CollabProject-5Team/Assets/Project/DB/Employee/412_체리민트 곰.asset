  style: "\uAC10\uAC01\uC788\uB294"
  hireText: "Yo, \uC0AC\uC7A5\uB2D8! \uBED4\uD558\uACE0 \uC9C0\uB8E8\uD55C \uADF8\uB798\uD53D\uC740
