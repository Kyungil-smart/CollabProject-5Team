  style: "\uC218\uC2B5"
  hireText: "\uC73C\uC544\uC559! \uC81C\uBC1C \uB5A8\uC5B4\uB728\uB9AC\uC9C0 \uB9D0\uC544
    \uC8FC\uC138\uC694! \uC5D0\uB7EC\uB294 \uB9CE\uC774 \uB0B4\uC9C0\uB9CC... \uC2E0\uAE30\uC220\uC740
