  fireText: "\uD750\uC5B4\uC5B5! \uC9C4\uC9DC \uC800 \uD574\uACE0\uC778\uAC00\uC694?!
    \uC73C\uC544\uC559!"
  fireText2: "\uC73C\uC559! \uC5ED\uC2DC \uC81C \uC720\uB9AC \uCF54\uB529 \uC2E4\uB825
    \uB54C\uBB38\uC5D0 \uC798\uB9AC\uB294 \uAC70\uAD70\uC694! \uC548\uB155\uD788
    \uACC4\uC138\uC694! \uC73C\uC544\uC559!"
  selfLeftText: "\uC73C\uC559! \uC544\uBB34\uB9AC \uB178\uB825\uD574\uB3C4 \uC544\uBB34\uB3C4\\n\uC54C\uC544\uBD10
