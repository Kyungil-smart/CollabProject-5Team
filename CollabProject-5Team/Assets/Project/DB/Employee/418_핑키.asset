  mbtiParsed: -1
  style: "\uACAC\uC2B5"
  hireText: "\uCE59\uCE59\uD558\uACE0 \uC7AC\uBBF8\uC5C6\uB294 \uAC8C\uC784\uC5D0
    \uC9C8\uB9AC\uC168\uC8E0? \uC81C\uAC00 \uC628 \uC138\uC0C1\uC744 \uC0AC\uB791\uC2A4\uB7FD\uACE0
    \uB2EC\uCF64\uD55C \uD551\uD06C \uD558\uD2B8\uBE5B\uC73C\uB85C \uAC00\uB4DD \uBB3C\uB4E4\uC5EC
    \uB4DC\uB9B4\uAC8C\uC694! \uBB34\uC870\uAC74 \uC808 \uCC44\uC6A9\uD558\uC154\uC57C
    \uD574\uC694, \uC544\uC167\uC8E0~? \u2665"
  fireText: "\uC9C4\uC9DC \uD551\uD0A4\uB97C \uBC84\uB9AC\uC2DC\uB294 \uAC74\uAC00\uC694?
    \uC804 \uC2AC\uD37C\uC2DC\uB824\uACE0 \uD558\uB294\uB370\uC694~"
  fireText2: "\uD5C9! \uC0AC\uB791\uC774 \uC5C6\uB294 \uC0AD\uB9C9\uD55C \uC5B4\uB460
    \uC18D\uC73C\uB85C \uC808 \uB0B4\uB358\uC9C0\uC2DC\uB294\uAD70\uC694... \uD558\uC9C0\uB9CC
    \uC0AC\uC7A5\uB2D8\uC758 \uC55E\uAE38\uC5D0 \uC0AC\uB791\uC73C\uB85C \uAC00\uB4DD\uCC2C
    \uAE38\uC774 \uC788\uAE38 \uBC14\uB798\uC694~ \uC544\uC167\uC8E0~?\u2665"
  selfLeftText: "\uC774 \uD68C\uC0AC\uB294 \uC0AC\uB791\uC774 \uBA54\uB9D0\uB790\uC5B4\uC694~\u2665\n\uBAA8\uB450
    \uC0AC\uB9AC\uC9C0\uAE30 \uC804\uC5D0 \uC0AC\uB791\uC744 \uB418\uCC3E\uAE38 \uBC14\uB798\uC694~\n\uC544\uC167\uC8E0~?\u2665"
