  style: "\uD3C9\uBC94\uD55C"
  hireText: "\uC800\uB294 \uD68C\uC0AC \uD0D5\uBE44\uC2E4 \uBBF9\uC2A4\uCEE4\uD53C\uAC00
    \uC5B8\uC81C \uB5A8\uC5B4\uC9C0\uB294\uC9C0\uBD80\uD130 \uACBD\uC7C1\uC0AC \uC2E0\uC791
