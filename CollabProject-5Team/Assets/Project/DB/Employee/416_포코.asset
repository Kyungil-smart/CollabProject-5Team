  fireText: "\uC545! \uC9C4\uC9DC \uC808 \uC790\uB974\uC2E4 \uAC70\uC5D0\uC694?!"
  fireText2: "\uD751, \uC81C\uAC00 \uB9CE\uC774 \uBD80\uC871\uD588\uB358 \uAC70\uAD70\uC694...
    \uCAD3\uACA8\uB098\uAE30 \uC804\uC5D0 \uBE68\uB9AC \uC9D0\uC744 \uC2F8\uC11C
    \uBC14\uB78C\uCC98\uB7FC \uC0AC\uB77C\uC9C0\uACA0\uC2B5\uB2C8\uB2E4... \uBD80\uB514
    \uAC74\uAC15\uD558\uC138\uC694! \uC545!"
  selfLeftText: "\uC545! \uC81C\uAC00 \uD1F4\uC0AC \uC9C0\uC6D0\uC11C\uB97C \uB123\uC5B4\uB3C4
    \uB418\uB294\uC9C0 \uD5C8\uB77D\uC744 \uBC1B\uC544\uB3C4 \uB418\uB294\uC9C0 \uC5EC\uCB48\uC5B4
    \uBD10\uB3C4 \uC81C\uAC00 \uB098\uAC00\uAC8C \uB3FC\uC11C \uD68C\uC0AC\uC758
    \uBBF8\uB798\uAC00 \uC554\uC6B8\uD558\uAC8C \uB41C\uAC83\uC774 \uAD1C\uCC2E\uC740\uC9C0
    \uAC10\uD788 \uC5EC\uCB48\uC5B4\uBCF4\uB294 \uAC83\uC744 \uD5C8\uB77D \uBC1B\uC544\uB3C4
