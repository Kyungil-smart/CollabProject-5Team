  style: "\uACAC\uC2B5"
  hireText: "\uC545! \uAC10\uD788 \uC9C0\uC6D0\uD574\uB3C4 \uB420\uAE4C\uC694...
    \uC18C\uB9AC\uB9CC \uC548 \uC9C0\uB974\uC2DC\uBA74 \uBC24\uC0C8\uC6CC\uC11C\uB77C\uB3C4
