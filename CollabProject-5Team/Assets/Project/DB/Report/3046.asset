  title: "\uCE74\uD230\uD48D \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 23
  startRepo: 1
  grade: 2
  role: 2
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uAE30\uC874 \uCE74\uD230\uD48D
    \uB300\uC791\uB4E4\uC758 \uD3F4\uB9AC\uACE4 \uC218\uC640 \uD14D\uC2A4\uCC98 \uC0AC\uC591\uC744
    \uCC38\uACE0\uD558\uC5EC \uD45C\uC900 \uAC00\uC774\uB4DC\uB97C \uC791\uC131\uD558\uACE0,
    \uBCF4\uD3B8\uC801\uC778  \\n UI \uC640\uC774\uC5B4\uD504\uB808\uC784\uC744 \uC81C\uC791\uD558\uC5EC
    \uAC1C\uBC1C \uD1B5\uC77C\uC131\uC744 \uD655\uBCF4\uD569\uB2C8\uB2E4. \uC548\uC815\uC801\uC778
    \uAC1C\uBC1C \uCCB4\uACC4 \uB9C8\uB828\uC744 \uC704\uD568\uC785\uB2C8\uB2E4.
    \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uAC1C\uBC1C \uD6A8\uC728\uC131 \uC99D\uB300\uC640
    \uC548\uC815\uC801\uC778 \uC544\uD2B8 \uD658\uACBD \uD655\uBCF4\uAC00 \uC608\uC0C1\uB429\uB2C8\uB2E4.
    \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n \uC544\uD2B8 \uC2A4\uD0C0\uC77C\uC758
    \uACE0\uC720 \uAC1C\uC131\uC774 \uB2E4\uC18C \uB5A8\uC5B4\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uC5C5\uACC4 \uD45C\uC900 \uAC00\uC774\uB4DC\uB97C
    \uCC38\uACE0\uD558\uC5EC \uAE30\uBCF8\uC801\uC778 \uAC1C\uBC1C \uD658\uACBD\uC744
    \uAC16\uCDC4\uC2B5\uB2C8\uB2E4. \\n"
  uiCategory: "\uCE74\uD230\uD48D"
