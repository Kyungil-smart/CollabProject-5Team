  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b>\\n \uAC8C\uC784 \uBA54\uC774\uCEA3\uC740
    \uC81C\uC791 \uC18D\uB3C4\uAC00 \uBE60\uB978 \uC5D4\uC9C4\uC785\uB2C8\uB2E4.\\n
    \uD50C\uB808\uC774 \uD14C\uC2A4\uD2B8\uB97C \uC6B0\uC120 \uC9C4\uD589\uD558\uAE30\uC5D0
    \uC801\uD569\uD569\uB2C8\uB2E4.\\n <b>\uAE30\uB300 \uD6A8\uACFC</b>\\n \uCD08\uAE30
    \uBC84\uC804\uC744 \uBE60\uB974\uAC8C \uC81C\uC791\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n
    <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b>\\n \uC77C\uBD80 \uC624\uB958\uAC00 \uADF8\uB300\uB85C
    \uB0A8\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n <b>\uCF54\uBA58\uD2B8</b>\\n
    \uBA3C\uC800 \uD50C\uB808\uC774\uD574 \uBCF4\uB294 \uAC83\uC774 \uAC00\uC7A5
    \uBE60\uB978 \uAC80\uC99D\uC77C \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\\n"
  uiCategory: "\uAC8C\uC784 \uBA54\uC774\uCEA3"
