  title: "\uC544\uD2B8 \uB9AC\uC18C\uC2A4 \uAD00\uB9AC \uBC0F \uD30C\uC774\uD504\uB77C\uC778
    \uC218\uB9BD"
  trait: 31
  startRepo: 0
