  title: "\uC560\uB2C8\uBA54\uC774\uC158\uD48D \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uC81C\uC548
    \uBCF4\uACE0\uC11C"
  trait: 27
  startRepo: 1
  grade: 2
  role: 2
  content: "\uC81C\uC548\uB0B4\uC6A9 \uC560\uB2C8\uBA54\uC774\uC158\uD48D \uC544\uC774\uB374\uD2F0\uD2F0\uC640
    \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uB97C \uC218\uB9BD\uD558\uACE0
    \uCE90\uB9AD\uD130\uC640 \uBC30\uACBD \uC870\uD654\uB97C \uB9DE\uCDA5\uB2C8\uB2E4.
    \uB2E8\uACC4\uC801 \uAC80\uD1A0\uB85C \uC2A4\uD0C0\uC77C\uC758 \uC548\uC815\uC131\uC744
    \uB192\uC774\uACA0\uC2B5\uB2C8\uB2E4. \uAE30\uB300\uD6A8\uACFC \uC2A4\uD0C0\uC77C
    \uAC00\uC774\uB4DC \uC801\uC6A9\uC73C\uB85C \uC81C\uC791\uC758 \uC548\uC815\uC131\uC774
    \uD5A5\uC0C1\uB429\uB2C8\uB2E4. \uC608\uC0C1 \uB9AC\uC2A4\uD06C \uCE90\uB9AD\uD130
    \uC5F0\uCD9C \uC2DC \uCD08\uAE30 \uC2DC\uD589\uCC29\uC624\uB85C \uC2DC\uAC04\uC774
    \uC18C\uC694\uB429\uB2C8\uB2E4. \uCF54\uBA58\uD2B8 \uAC00\uC774\uB4DC\uB97C \uCCA0\uC800\uD788
    \uC900\uC218\uD558\uC5EC \uACB0\uACFC\uBB3C\uC744 \uC900\uBE44\uD588\uC2B5\uB2C8\uB2E4.
    \uAC80\uD1A0 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4. "
  uiCategory: "\uC560\uB2C8\uBA54\uC774\uC158\uD48D"
