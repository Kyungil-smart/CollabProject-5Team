  title: "\uD53D\uC140/\uB3C4\uD2B8 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 30
  startRepo: 1
  grade: 3
  role: 2
  content: "\uC81C\uC548\uB0B4\uC6A9 \uD53D\uC140 \uBE44\uC8FC\uC5BC \uC544\uC774\uB374\uD2F0\uD2F0\uC640
    \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uB97C \uB2E8\uC21C \uC801\uC6A9\uD569\uB2C8\uB2E4. 
    \uC81C\uC791 \uACF5\uC815\uC744 \uAC04\uC18C\uD654\uD558\uACE0 \uD45C\uC900\uD654\uB41C
    \uD669\uAE08 \uAD6C\uB3C4 \uD2C0\uC5D0 \uB9DE\uCDB0 \uC5D0\uC14B\uC744 \uBC30\uCE58\uD558\uC5EC
    \uC644\uB8CC\uD569\uB2C8\uB2E4. \uAE30\uB300\uD6A8\uACFC \uB2E8\uC21C\uD654\uB41C
    \uAD6C\uB3C4 \uD504\uB85C\uC138\uC2A4\uB85C \uC81C\uC791 \uD6A8\uC728\uC744 \uD06C\uAC8C
    \uB192\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC608\uC0C1 \uB9AC\uC2A4\uD06C
    \uAD6C\uB3C4\uC758 \uB2E8\uC21C \uBC30\uCE58\uB85C \uC778\uD574 \uD654\uBA74\uC758
    \uC2EC\uBBF8\uC801 \uAE4A\uC774\uAC00 \uC595\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uCF54\uBA58\uD2B8 \uAE30\uD55C\uC744 \uC900\uC218\uD558\uAE30 \uC704\uD574 \uD6A8\uC728\uC801\uC73C\uB85C
    \uC791\uC5C5\uD588\uC2B5\uB2C8\uB2E4. \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
  uiCategory: "\uD53D\uC140/\uB3C4\uD2B8"
