  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b>\\n \uAE30\uB2A5\uC744 \uBE60\uB974\uAC8C
    \uBD99\uC774\uACE0 \uD655\uC778\uD558\uAE30\uC5D0\uB294 \uBBA4\uB2C8\uD2F0\uAC00
    \uBB34\uB09C\uD574 \uBCF4\uC785\uB2C8\uB2E4.\\n <b>\uAE30\uB300 \uD6A8\uACFC</b>\\n
    \uC218\uC815 \uB300\uC751\uACFC \uAE30\uB2A5 \uD655\uC778\uC774 \uC26C\uC6CC\uC9D1\uB2C8\uB2E4.\\n
    <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b>\\n \uC18D\uB3C4\uC5D0 \uCE58\uC6B0\uCE58\uBA74
    \uAD6C\uC870 \uC815\uB9AC\uAC00 \uB2A6\uC5B4\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n
    <b>\uCF54\uBA58\uD2B8</b>\\n \uC18D\uB3C4 \uB4A4\uC5D4 \uC810\uAC80\uC774 \uD544\uC694\uD569\uB2C8\uB2E4.\\n"
  uiCategory: "\uBBA4\uB2C8\uD2F0"
