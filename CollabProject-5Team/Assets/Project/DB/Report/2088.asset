  title: "\uD14C\uB9C8\uD30C\uD06C \uD0C0\uC774\uCFE4 \uC7A5\uB974 \uC81C\uC548\uC11C"
  trait: 4
  startRepo: 1
  grade: 2
  role: 1
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uB180\uC774\uAE30\uAD6C \uC5D0\uC14B\uC744
    \uC801\uB2F9\uD788 \uBC30\uCE58\uD560 \uC218 \uC788\uB294 \uD14C\uB9C8\uD30C\uD06C
    \uAC74\uC124 \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974 \uC81C\uC548. \\n \uAC04\uB2E8\uD55C
    \uB180\uC774\uAE30\uAD6C\uB4E4\uC744 \uB9C8\uC74C\uB300\uB85C \uBC30\uCE58\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uB180\uC774\uAE30\uAD6C
    \uC885\uB958\uAC00 \uC801\uC5B4\uC11C \uC720\uC800\uB4E4\uC774 \uACBD\uC601\uACC4\uC0B0
    \uC5C6\uC774 \uB69D\uB531 \uB180\uC774\uACF5\uC6D0\uC744 \uB9CC\uB4E4 \uC218
    \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n \uACBD\uC601
    \uC694\uC18C\uAC00 \uC801\uAE30 \uB54C\uBB38\uC5D0 \uB9C8\uB2C8\uC544 \uCE35\uC5D0\uAC8C\uB294
    \uC595\uC740 \uAC8C\uC784\uC774\uB77C\uB294 \uC9C0\uC801\uC744 \uBC1B\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uC575\uADF8\uB9AC\uC870\uB958\uCC98\uB7FC
    \uB180\uC774\uAE30\uAD6C\uB85C \uC190\uB2D8\uC744 \uB358\uC9C0\uB294 \uC774\uBCA4\uD2B8\uB97C
    \uB123\uC73C\uBA74 \uCEE4\uBBA4\uB2C8\uD2F0\uC5D0\uC11C \uB300\uBC15 \uB0A0\uAC70\uC5D0\uC694!
    \\n"
  uiCategory: "\uC2DC\uBBAC\uB808\uC774\uC158"
