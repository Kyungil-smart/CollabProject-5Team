  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b>\\n \uBCC0\uACBD \uB300\uC751\uC774 \uB2A6\uC5B4\uC9C8
    \uC218 \uC788\uC5B4, \uAE30\uB2A5 \uAD6C\uC870\uAC00 \uBA85\uD655\uD55C \uCEA3\uC18C\uC2A42\uB97C
    \uC81C\uC548\uD569\uB2C8\uB2E4.\\n <b>\uAE30\uB300 \uD6A8\uACFC</b>\\n \uC218\uC815
    \uBC94\uC704 \uD30C\uC545\uACFC \uAC80\uC218 \uD750\uB984\uC774 \uC548\uC815\uB429\uB2C8\uB2E4.\\n
    <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b>\\n \uACE0\uAE09 \uAE30\uB2A5 \uAC80\uD1A0\uC5D0
    \uC2DC\uAC04\uC774 \uB354 \uAC78\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n <b>\uCF54\uBA58\uD2B8</b>\\n
    \uBCC0\uACBD \uAD00\uB9AC \uB9AC\uC2A4\uD06C\uB97C \uC904\uC774\uB294 \uC120\uD0DD\uC785\uB2C8\uB2E4.\\n"
  uiCategory: "\uCEA3\uC18C\uC2A42"
