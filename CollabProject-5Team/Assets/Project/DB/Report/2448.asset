  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uB300\uC911\uC801\uC778 \uC0C9\uCC44
    \uC120\uD638\uB3C4 \uD1B5\uACC4\uB97C \uAE30\uBC18\uC73C\uB85C \uD638\uBD88\uD638
    \uC5C6\uB294 \uCE90\uC8FC\uC5BC \uC7A5\uB974 \uC81C\uC548. \\n \uB2E4\uB4E4 \uB9CE\uC774
    \uC0AC\uC6A9\uD558\uB294 \uC0C9\uAC10\uACFC \uC9C1\uAD00\uC801\uC778 \uBE14\uB85D
    \uB9E4\uCE6D \uB8F0\uC744 \uACB0\uD569\uD569\uB2C8\uB2E4. \\n <b>\uAE30\uB300
    \uD6A8\uACFC</b> \\n \uD1B5\uACC4\uAC00 \uC99D\uBA85\uD558\uB294 \uB300\uC911\uC801\uC778
    \uB514\uC790\uC778\uC73C\uB85C \uC548\uC815\uC801\uC778 \uC720\uC800 \uD480\uC744
    \uCC59\uAE41\uB2C8\uB2E4. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n \uB108\uBB34
    \uD754\uD55C \uB514\uC790\uC778\uC774\uB77C \uACBD\uC7C1\uC791\uB4E4 \uC0AC\uC774\uC5D0\uC11C
    \uB208\uC5D0 \uB744\uAE30 \uC5B4\uB824\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uC5C5\uACC4 \uD3C9\uADE0 \uC9C0\uD45C\uB97C
    \uAF3C\uAF3C\uD788 \uB530\uC838 \uC81C\uC77C \uC548 \uB9DD\uD560 \uAC83 \uAC19\uC740
    \uADF8\uB798\uD53D\uB9CC \uC11E\uC5C8\uC2B5\uB2C8\uB2E4. \\n"
  uiCategory: "\uCE90\uC8FC\uC5BC"
