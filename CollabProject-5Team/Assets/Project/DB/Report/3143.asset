  title: "\uC560\uB2C8\uBA54\uC774\uC158\uD48D \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uC81C\uC548
    \uBCF4\uACE0\uC11C"
  trait: 28
  startRepo: 1
  grade: 3
  role: 2
  content: "\uC81C\uC548\uB0B4\uC6A9 \uC560\uB2C8\uBA54\uC774\uC158\uD48D \uC544\uC774\uB374\uD2F0\uD2F0\uC640
    \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uB97C \uD45C\uC900\uD654\uD558\uC5EC
    \uC81C\uC791 \uACF5\uC815\uC744 \uCD5C\uC801\uD654\uD569\uB2C8\uB2E4. \uC5F0\uCD9C\uC744
    \uAC04\uC18C\uD654\uD558\uC5EC \uAE30\uD55C\uC744 \uB9DE\uCD94\uB294 \uB370 \uC9D1\uC911\uD558\uACA0\uC2B5\uB2C8\uB2E4.
    \uAE30\uB300\uD6A8\uACFC \uC81C\uC791 \uB2E8\uACC4 \uAC04\uC18C\uD654\uB85C \uC131\uACFC
    \uB2EC\uC131\uC774 \uAC00\uB2A5\uD574\uC9D1\uB2C8\uB2E4. \uC608\uC0C1 \uB9AC\uC2A4\uD06C
    \uC5F0\uCD9C\uC774 \uB2E4\uC18C \uBC0B\uBC0B\uD558\uAC8C \uD45C\uD604\uB420 \uC218
    \uC788\uC2B5\uB2C8\uB2E4. \uCF54\uBA58\uD2B8 \uAE30\uD55C\uC744 \uB9DE\uCD94\uAE30
    \uC704\uD574 \uAC00\uC774\uB4DC\uB97C \uCDA9\uC2E4\uD788 \uC774\uD589\uD588\uC2B5\uB2C8\uB2E4."
  uiCategory: "\uC560\uB2C8\uBA54\uC774\uC158\uD48D"
