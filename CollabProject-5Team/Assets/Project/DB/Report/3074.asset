  title: "\uB9AC\uC5BC\uB9AC\uC998 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uC81C\uC548 \uBCF4\uACE0\uC11C"
  trait: 25
  startRepo: 1
  grade: 3
  role: 2
  content: "\uC81C\uC548\uB0B4\uC6A9 \uC815\uD574\uC9C4 \uB9AC\uC5BC\uB9AC\uC998
    \uBE44\uC8FC\uC5BC \uC544\uC774\uB374\uD2F0\uD2F0\uC640 \uD575\uC2EC \uCEEC\uB7EC
    \uD1A4\uC564\uB9E4\uB108 \uBC94\uC704 \uB0B4\uC5D0\uC11C \uD45C\uC900 \uC5D0\uC14B\uC744 
    \uC0AC\uC6A9\uD558\uC5EC \uC791\uC5C5\uC758 \uBCF5\uC7A1\uB3C4\uB97C \uC904\uC774\uACE0
    \uACB0\uACFC\uBB3C\uC744 \uB3C4\uCD9C\uD558\uB294 \uC81C\uC791 \uBC29\uC2DD\uC744
    \uC81C\uC548\uD569\uB2C8\uB2E4. \uAE30\uB300\uD6A8\uACFC \uC77C\uAD00\uB41C \uC2E4\uC0AC
    \uC544\uD2B8 \uC5D0\uC14B \uD655\uBCF4\uB85C \uC81C\uC791 \uAE30\uAC04\uC774
    \uB2E8\uCD95\uB429\uB2C8\uB2E4. \uC608\uC0C1 \uB9AC\uC2A4\uD06C \uC138\uBC00\uD55C
    \uD45C\uD604\uB825\uC5D0\uC11C \uB2E4\uC18C \uC544\uC26C\uC6B4 \uACB0\uACFC\uAC00
    \uBC1C\uC0DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCF54\uBA58\uD2B8 \uC815\uD574\uC9C4
    \uAE30\uD55C \uB0B4\uC5D0 \uACB0\uACFC\uBB3C\uC744 \uB0B4\uB3C4\uB85D \uCD5C\uC120\uC744
    \uB2E4\uD588\uC2B5\uB2C8\uB2E4. \uC0B4\uD3B4\uBD10 \uC8FC\uC2ED\uC2DC\uC624."
  uiCategory: "\uB9AC\uC5BC\uB9AC\uC998"
