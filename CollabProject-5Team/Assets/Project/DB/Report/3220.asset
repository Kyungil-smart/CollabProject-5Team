  title: "\uB9AC\uC5BC\uB9AC\uC998 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uC81C\uC548 \uBCF4\uACE0\uC11C"
  trait: 32
  startRepo: 1
  grade: 2
  role: 2
  content: "\uC81C\uC548 \uB0B4\uC6A9 \uC2E4\uC0AC \uD48D\uC758 \uD45C\uC900 \uD14D\uC2A4\uCC98
    \uD574\uC0C1\uB3C4\uC640 \uD3F4\uB9AC\uACE4 \uC0AC\uC591\uC744 \uC124\uC815\uD558\uACE0,
    \uBCF4\uD3B8\uC801\uC778 UI \uC640\uC774\uC5B4\uD504\uB808\uC784\uC744  \uC81C\uC791\uD558\uC5EC
    \uC2DC\uC2A4\uD15C \uC544\uD2B8 \uD658\uACBD\uC744 \uAD6C\uCD95\uD569\uB2C8\uB2E4.
    \uC2E4\uC0AC\uC758 \uC2E0\uB8B0\uB3C4 \uC720\uC9C0\uB97C \uC704\uD568\uC785\uB2C8\uB2E4.
    \uAE30\uB300 \uD6A8\uACFC \uC804\uCCB4\uC801\uC778 \uC2E4\uC0AC \uADF8\uB798\uD53D
    \uD1B5\uC77C\uC131 \uBC0F \uAD00\uB9AC\uAC00 \uC608\uC0C1\uB429\uB2C8\uB2E4.
    \uC608\uC0C1 \uB9AC\uC2A4\uD06C \uB9AC\uC5BC\uB9AC\uC998 \uD2B9\uC720\uC758 \uACE0\uD004\uB9AC\uD2F0
    \uC5F0\uCD9C\uC774 \uBD80\uC871\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCF54\uBA58\uD2B8
    \uC815\uD574\uC9C4 \uD45C\uC900\uC5D0 \uB9DE\uCDB0 \uB9AC\uC5BC\uB9AC\uC998\uC758
    \uAE30\uBCF8\uC744 \uC9C0\uCF30\uC2B5\uB2C8\uB2E4."
  uiCategory: "\uB9AC\uC5BC\uB9AC\uC998"
