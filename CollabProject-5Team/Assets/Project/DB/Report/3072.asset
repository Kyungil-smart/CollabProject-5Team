  title: "\uB9AC\uC5BC\uB9AC\uC998 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uC81C\uC548 \uBCF4\uACE0\uC11C"
  trait: 25
  startRepo: 1
  grade: 1
  role: 2
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uB9AC\uC5BC\uB9AC\uC998 \uBE44\uC8FC\uC5BC
    \uC544\uC774\uB374\uD2F0\uD2F0\uC640 \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uB97C
    \uAE4A\uAC8C \uBD84\uC11D\uD558\uC5EC, \\n \uC2E4\uC0AC\uD615 \uC544\uD2B8\uC758
    \uC0AC\uC2E4\uC131\uC744 \uADF9\uB300\uD654\uD558\uACE0 \uC0AC\uC6A9\uC790 \uBAB0\uC785\uB3C4\uB97C
    \uCD5C\uACE0\uCE58\uB85C \uB04C\uC5B4\uC62C\uB9AC\uB294 \uC81C\uC791 \uBC29\uC2DD\uC744
    \uC81C\uC548\uD569\uB2C8\uB2E4. \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uC2DC\uAC01\uC801
    \uC0AC\uC2E4\uC131 \uAD6C\uD604\uC73C\uB85C \uC0AC\uC6A9\uC790 \uBAB0\uC785\uAC10\uC774
    \uC0C1\uC2B9\uD569\uB2C8\uB2E4. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n
    \uB514\uD14C\uC77C \uCD94\uAD6C\uC5D0 \uB530\uB978 \uB9AC\uC18C\uC2A4 \uC81C\uC791
    \uC2DC\uAC04\uC774 \uB300\uD3ED \uC99D\uAC00\uD569\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b>
    \\n \uC555\uB3C4\uC801\uC778 \uB9AC\uC5BC\uB9AC\uC998 \uD658\uACBD\uC744 \uC9C1\uC811
    \uAD6C\uCD95\uD558\uB294 \uAC74 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C? \uC5F4\uC2EC\uD788
    \uB178\uB825\uD588\uC2B5\uB2C8\uB2E4. \\n"
  uiCategory: "\uB9AC\uC5BC\uB9AC\uC998"
