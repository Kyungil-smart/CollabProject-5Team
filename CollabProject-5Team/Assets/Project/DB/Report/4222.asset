  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b>\\n \uC791\uC740 \uAE30\uB2A5\uB3C4 \uC9C0\uC5F0\uB420
    \uC218 \uC788\uC5B4, \uC81C\uC791 \uB2E8\uC704\uAC00 \uC9E7\uC740 \uAC8C\uC784
    \uBA54\uC774\uCEA3\uC744 \uC81C\uC548\uD569\uB2C8\uB2E4.\\n <b>\uAE30\uB300 \uD6A8\uACFC</b>\\n
    \uAE30\uB2A5\uBCC4 \uC9C4\uD589 \uC0C1\uD669\uC744 \uBE60\uB974\uAC8C \uD655\uC778\uD569\uB2C8\uB2E4.\\n
    <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b>\\n \uBCF5\uC7A1\uD55C \uD655\uC7A5 \uC791\uC5C5\uC740
    \uB2A6\uC5B4\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n <b>\uCF54\uBA58\uD2B8</b>\\n
    \uB290\uB9B0 \uC9C4\uD589\uC744 \uC791\uC740 \uB2E8\uC704\uB85C \uAD00\uB9AC\uD569\uB2C8\uB2E4.\\n"
  uiCategory: "\uAC8C\uC784 \uBA54\uC774\uCEA3"
