  title: "\uB9AC\uC5BC\uB9AC\uC998 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uC81C\uC548 \uBCF4\uACE0\uC11C"
  trait: 30
  startRepo: 1
  grade: 3
  role: 2
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uB9AC\uC5BC\uB9AC\uC998 \uBE44\uC8FC\uC5BC
    \uC544\uC774\uB374\uD2F0\uD2F0\uC640 \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108
    \uB0B4\uC5D0\uC11C \uD45C\uC900 \uC5D0\uC14B\uC744 \uC501\uB2C8\uB2E4. \uBCF5\uC7A1\uD55C
    \uAD6C\uB3C4 \uC124\uC815\uC744 \uBC30\uC81C\uD558\uACE0 \uAE30\uD55C \uB0B4
    \uACB0\uACFC\uBB3C\uC744 \uB0B4\uB294 \uB370 \uC9D1\uC911\uD569\uB2C8\uB2E4.
    \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uC77C\uAD00\uB41C \uD45C\uC900 \uAD6C\uB3C4
    \uC801\uC6A9\uC73C\uB85C \uB9AC\uC18C\uC2A4 \uC81C\uC791 \uC2DC\uAC04\uC744 \uB2E8\uCD95\uD569\uB2C8\uB2E4.
    \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n \uB9AC\uC5BC\uB9AC\uC998 \uD2B9\uC720\uC758
    \uC138\uBC00\uD55C \uAD6C\uB3C4 \uC608\uC220\uC131\uC774 \uC77C\uBD80 \uC0DD\uB7B5\uB429\uB2C8\uB2E4.
    \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uC815\uD574\uC9C4 \uAE30\uD55C \uB0B4\uC5D0
    \uACB0\uACFC\uBB3C\uC744 \uB0B4\uB3C4\uB85D \uCD5C\uC120\uC744 \uB2E4\uD588\uC2B5\uB2C8\uB2E4.
    \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4. \\n"
  uiCategory: "\uB9AC\uC5BC\uB9AC\uC998"
