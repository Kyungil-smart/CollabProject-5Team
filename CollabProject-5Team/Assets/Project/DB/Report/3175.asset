  title: "\uD53D\uC140/\uB3C4\uD2B8 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 30
  startRepo: 1
  grade: 2
  role: 2
  content: "\uC81C\uC548\uB0B4\uC6A9 \uD53D\uC140 \uBE44\uC8FC\uC5BC \uC544\uC774\uB374\uD2F0\uD2F0\uC640
    \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uB97C \uAE30\uC900\uC73C\uB85C
    \uBC30\uCE58\uD569\uB2C8\uB2E4.  \uD669\uAE08 \uAD6C\uB3C4 \uAC00\uC774\uB4DC\uC5D0
    \uB9DE\uCDB0 \uD575\uC2EC \uC624\uBE0C\uC81D\uD2B8\uC758 \uC704\uCE58\uB97C \uC870\uC815\uD558\uBA70
    \uCC28\uBD84\uD55C \uD654\uBA74\uC744 \uC870\uC131\uD569\uB2C8\uB2E4. \uAE30\uB300\uD6A8\uACFC
    \uAD6C\uB3C4 \uAC00\uC774\uB4DC\uB97C \uD1B5\uD574 \uC815\uB3C8\uB41C \uD53D\uC140
    \uC544\uD2B8 \uD654\uBA74\uC744 \uD655\uBCF4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uC608\uC0C1 \uB9AC\uC2A4\uD06C \uB3C4\uD2B8\uC758 \uD2B9\uC131\uC0C1 \uAD6C\uB3C4\uC5D0
    \uC644\uBCBD\uD788 \uB9DE\uCD94\uB294 \uC791\uC5C5\uC774 \uB2E4\uC18C \uAE4C\uB2E4\uB86D\uC2B5\uB2C8\uB2E4.
    \uCF54\uBA58\uD2B8 \uAC00\uC774\uB4DC\uB97C \uBC14\uD0D5\uC73C\uB85C \uC815\uB3C8\uB41C
    \uD53D\uC140 \uD654\uBA74\uC744 \uB0B4\uB3C4\uB85D \uB178\uB825\uD588\uC2B5\uB2C8\uB2E4.
    \uD655\uC778 \uBC14\uB78D\uB2C8\uB2E4."
  uiCategory: "\uD53D\uC140/\uB3C4\uD2B8"
