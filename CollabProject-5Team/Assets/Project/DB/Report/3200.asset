  title: "\uB9AC\uC5BC\uB9AC\uC998 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uC81C\uC548 \uBCF4\uACE0\uC11C"
  trait: 31
  startRepo: 1
  grade: 3
  role: 2
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uB9AC\uC5BC\uB9AC\uC998 \uC2A4\uD0C0\uC77C\uC744
    \uC0AC\uC6A9\uD558\uC5EC \uD654\uBA74 \uC804\uBC18\uC5D0 \uC0AC\uC2E4\uC801\uC778
    \uC9C8\uAC10\uACFC \uB514\uD14C\uC77C\uC744 \uBB18\uC0AC\uD558\uB294 \uC791\uC5C5\uC744
    \uC9C4\uD589\uD560 \uAC83\uC744 \uC81C\uC548\uD569\uB2C8\uB2E4. \\n \uB9AC\uC5BC\uB9AC\uC998
    \uC2A4\uD0C0\uC77C\uC774 \uD2B8\uB80C\uB4DC\uC5D0 \uC801\uD569\uD558\uBA70, \uC0AC\uC2E4\uC801\uC778
    \uD45C\uD604\uC774 \uAC00\uB2A5\uD558\uAE30 \uB54C\uBB38\uC785\uB2C8\uB2E4. \\n
    <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uD654\uBA74\uC758 \uC0AC\uC2E4\uC801\uC778
    \uD004\uB9AC\uD2F0 \uD5A5\uC0C1. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n
    \uD654\uBA74 \uAD6C\uC131\uC774 \uB2E4\uC18C \uBCF5\uC7A1\uD558\uAC8C \uB290\uAEF4\uC9C8
    \uC218 \uC788\uC74C. \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uC804\uCCB4\uC801\uC778
    \uC0C9\uAC10\uC744 \uC0AC\uC2E4\uC801\uC73C\uB85C \uC870\uC815\uD558\uC5EC \uBC30\uCE58\uD558\uC2DC\uAE30
    \uBC14\uB78D\uB2C8\uB2E4. \\n"
  uiCategory: "\uB9AC\uC5BC\uB9AC\uC998"
