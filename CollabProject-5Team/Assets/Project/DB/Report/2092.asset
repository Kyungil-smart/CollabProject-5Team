  title: "\uB3C4\uC2DC \uAC74\uC124 \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974 \uC81C\uC548\uC11C"
  trait: 10
  startRepo: 1
  grade: 3
  role: 1
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uC2DC\uC791\uD558\uC790\uB9C8\uC790
    \uAC70\uB300 \uC6B4\uC11D\uC774 \uB5A8\uC5B4\uC9C8 \uC704\uAE30\uC5D0 \uBD09\uCC29\uD558\uB294
    \uC9C0\uAD6C \uC885\uB9D0 1\uCD08\uC804 \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974
    \uC81C\uC548. \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uB3C4\uB85C\uB97C \uAE54\uAC70\uB098
    \uAC74\uBB3C\uC744 \uC62C\uB9AC\uB294 \uBCF5\uC7A1\uD55C \uAC74\uC124 \uAE30\uD68D
    \uC5C6\uC774, \uD30C\uAD34 \uC774\uD399\uD2B8\uB9CC \uACF5\uB4E4\uC774\uBA74
    \uB429\uB2C8\uB2E4. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n \uC720\uC800\uB4E4\uC740
    \uC9D3\uC9C0\uB3C4 \uC54A\uC740 \uB3C4\uC2DC\uAC00 \uD130\uC838\uBC84\uB824\uC11C
    \uB2F9\uD669\uC2A4\uB7EC\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b>
    \\n \uB3C4\uC2DC\uAC00 \uD130\uC9C8\uB54C \uB098\uC624\uB294 \uD3ED\uBC1C\uC18C\uB9AC\uB294
    \uC9C4\uC9DC \uC6C5\uC7A5\uD574\uC57C \uD569\uB2C8\uB2E4!! \\n"
  uiCategory: "\uC2DC\uBBAC\uB808\uC774\uC158"
