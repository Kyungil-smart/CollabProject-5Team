  title: "\uD53D\uC140/\uB3C4\uD2B8 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 31
  startRepo: 1
  grade: 3
  role: 2
  content: "\uC81C\uC548\uB0B4\uC6A9 \uD53D\uC140 \uBE44\uC8FC\uC5BC \uC544\uC774\uB374\uD2F0\uD2F0\uC640
    \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uB97C \uC720\uC9C0\uD558\uACE0,
    \uB2E8\uC21C\uD55C \uBC30\uCE58 \uC6D0\uCE59\uC744 \uC801\uC6A9\uD558\uC5EC \uD654\uBA74\uC758
    \uC0B0\uB9CC\uD568\uC744 \uC904\uC5EC \uD6A8\uC728\uC744 \uC911\uC2DC\uD569\uB2C8\uB2E4.
    \uAE30\uB300\uD6A8\uACFC \uAD6C\uB3C4 \uB2E8\uC21C\uD654\uB85C \uC81C\uC791 \uACF5\uC815\uC744
    \uC904\uC5EC \uB9C8\uAC10 \uAE30\uD55C\uC744 \uC900\uC218\uD569\uB2C8\uB2E4.
    \uC608\uC0C1 \uB9AC\uC2A4\uD06C \uAD6C\uB3C4\uAC00 \uC815\uD615\uD654\uB418\uC5B4
    \uD654\uBA74 \uC5F0\uCD9C\uC758 \uB2E4\uC591\uC131\uC774 \uBD80\uC871\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4. \uCF54\uBA58\uD2B8 \uAE30\uD55C \uB0B4 \uB9C8\uAC10\uC744
    \uC704\uD574 \uD6A8\uC728\uC801\uC73C\uB85C \uD654\uBA74\uC744 \uC815\uB9AC\uD558\uBA70
    \uB178\uB825\uD588\uC2B5\uB2C8\uB2E4. "
  uiCategory: "\uD53D\uC140/\uB3C4\uD2B8"
