  title: "\uD3B8\uC758\uC810 \uACBD\uC601 \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974
    \uC81C\uC548\uC11C"
  trait: 6
  startRepo: 1
  grade: 2
  role: 1
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uC190\uB2D8\uC774 \uC6D0\uD558\uB294
    \uBB3C\uAC74\uC744 \uACC4\uC0B0\uD574\uC8FC\uACE0 \uD3B8\uC758\uC810\uC744 \uD655\uC7A5\uC2DC\uD0A4\uB294
    \uACBD\uC601 \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974 \uC81C\uC548. \\n \uC791\uC740
    \uB3D9\uB124 \uB9E4\uC7A5\uC744 \uD0A4\uC6CC\uB098\uAC00\uB294 \uAD6C\uC870\uC785\uB2C8\uB2E4.
    \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uACC4\uC0B0\uB300 \uD130\uCE58\uC640
    \uBB3C\uAC74 \uCC44\uC6CC\uB123\uAE30 \uC704\uC8FC\uC758 \uB2E8\uC21C\uD55C \uD50C\uB808\uC774\uB85C
    \uD0AC\uB9C1\uD0C0\uC784 \uC6A9\uC73C\uB85C \uC990\uAE30\uAE30 \uC88B\uC2B5\uB2C8\uB2E4.
    \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n \uC911\uBC18 \uC774\uD6C4\uB85C
    \uD3B8\uC758\uC810\uC774 \uB113\uC5B4\uC9C0\uBA74 \uC720\uC800\uAC00 \uC9C0\uB8E8\uD568\uC744
    \uB290\uB07C\uAC8C \uB420 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b>
    \\n \uC190\uB2D8\uC73C\uB85C \uACE0\uC591\uC774\uB098 \uAC15\uC544\uC9C0\uAC00
    \uC624\uAC8C \uB9CC\uB4E4\uBA74 \uADC0\uC5EC\uC6B8 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4!
    \\n"
  uiCategory: "\uC2DC\uBBAC\uB808\uC774\uC158"
