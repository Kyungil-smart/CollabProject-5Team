  title: "\uD53D\uC140/\uB3C4\uD2B8 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 26
  startRepo: 1
  grade: 2
  role: 2
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uD53D\uC140 \uBE44\uC8FC\uC5BC
    \uC544\uC774\uB374\uD2F0\uD2F0\uC640 \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uB97C
    \uAE30\uC900\uC73C\uB85C \uB2E8\uACC4\uC801\uC778 \uC5D0\uC14B \uC81C\uC791 \uACF5\uC815\uC744
    \uB3C4\uC785\uD574 \uC2A4\uD0C0\uC77C\uC744 \uC815\uCC29\uC2DC\uD0A4\uACA0\uC2B5\uB2C8\uB2E4.
    \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uC544\uD2B8 \uAC00\uC774\uB4DC\uB97C
    \uCCB4\uACC4\uC801\uC73C\uB85C \uC815\uB9BD\uD558\uC5EC \uC791\uC5C5 \uC77C\uAD00\uC131\uC744
    \uD655\uBCF4\uD569\uB2C8\uB2E4. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n
    \uC815\uBC00\uD55C \uC791\uC5C5 \uACF5\uC815\uC73C\uB85C \uC778\uD574 \uCD08\uAE30
    \uAC1C\uBC1C \uC2DC\uAC04\uC774 \uACFC\uB2E4 \uC18C\uC694\uB429\uB2C8\uB2E4.
    \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uAC00\uC774\uB4DC\uB97C \uC900\uC218\uD558\uC5EC
    \uC548\uC815\uC801\uC778 \uACB0\uACFC\uBB3C\uC744 \uB0B4\uB3C4\uB85D \uB178\uB825\uD588\uC2B5\uB2C8\uB2E4.
    \uAC80\uD1A0 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4. \\n"
  uiCategory: "\uD53D\uC140/\uB3C4\uD2B8"
