  title: "\uD1B5\uACC4 \uBD84\uC11D\uD615 \uC2A4\uD1A0\uB9AC \uC7A5\uB974 \uC81C\uC548\uC11C"
  trait: 9
  startRepo: 1
  grade: 3
  role: 1
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uD130\uCE58 \uBE48\uB3C4\uAC00
    \uC7AC\uBBF8\uB77C\uB294 \uC9C0\uD45C\uB97C \uD65C\uC6A9\uD55C \uD654\uBA74\uB9CC
    \uC5F0\uD0C0\uD558\uB294 \uC2A4\uD1A0\uB9AC \uC7A5\uB974 \uC81C\uC548. \\n \uAE00
    \uC5C6\uC774 \uBC31\uC9C0\uB9CC \uCD9C\uB825\uD574 \uC0C1\uC0C1\uC73C\uB85C \uC11C\uC0AC\uB97C
    \uC4F0\uB3C4\uB85D \uB5A0\uB118\uAE41\uB2C8\uB2E4. \\n <b>\uAE30\uB300 \uD6A8\uACFC</b>
    \\n \uD130\uCE58 \uD69F\uC218 \uB370\uC774\uD130\uB9CC\uD07C\uC740 \uC5ED\uB300
    \uCD5C\uACE0\uCE58\uB97C \uCC0D\uC5B4 \uBCF4\uACE0\uC11C\uAC00 \uD654\uB824\uD574\uC9C8
    \uAC81\uB2C8\uB2E4. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n \uC544\uBB34\uB7F0
    \uB0B4\uC6A9\uC774 \uC5C6\uC5B4\uC11C \uC720\uC800\uB4E4\uC774 \uBC84\uADF8\uB85C
    \uC624\uD574\uD558\uACE0 \uD654\uB97C \uB0BC \uC6B0\uB824\uAC00 \uC788\uC2B5\uB2C8\uB2E4.
    \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uD130\uCE58\uC728 \uC9C0\uD45C\uAC00 \uD558\uB298\uC744
    \uB6AB\uACE0 \uC788\uC73C\uB2C8 \uC2A4\uD1A0\uB9AC\uAC00 \uD6CC\uB96D\uD55C \uAC8C
    \uD2C0\uB9BC\uC5C6\uC2B5\uB2C8\uB2E4. \\n"
  uiCategory: "\uD1B5\uACC4"
