  title: "\uD2B8\uB7ED \uC6B4\uC804 \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974 \uC81C\uC548\uC11C"
  trait: 0
  startRepo: 1
  grade: 1
  role: 1
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uC2E4\uC81C \uB300\uD615 \uD2B8\uB7ED\uC774\uB098
    \uD56D\uACF5\uAE30\uC758 \uACC4\uAE30\uD310 \uC870\uC791\uACFC \uAD00\uC131\uBC95\uCE59\uC744
    \uADF8\uB300\uB85C \uC774\uC2DD\uD55C \uADF9\uC0AC\uC2E4\uC8FC\uC758 \uC2DC\uBBAC\uB808\uC774\uC158
    \uC7A5\uB974 \uC81C\uC548. \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uC2E4\uC81C
    \uC870\uC885\uC11D\uC5D0 \uC549\uC740 \uB4EF\uD55C \uC644\uBCBD\uD55C \uC870\uC791
    \uBA54\uCEE4\uB2C8\uC998\uC73C\uB85C \uB9C8\uB2C8\uC544\uCE35\uC758 \uAD00\uC2EC\uC744
    \uC0AC\uB85C\uC7A1\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uC608\uC0C1
    \uB9AC\uC2A4\uD06C</b> \\n \uC815\uAD50\uD55C \uBB3C\uB9AC\uC5D4\uC9C4 \uCEE4\uC2A4\uD140
    \uD29C\uB2DD\uC73C\uB85C \uCD08\uAE30 \uAC1C\uBC1C\uBE44 \uBC0F \uBC95\uC801
    \uAC80\uD1A0 \uBE44\uC6A9\uC774 \uBC1C\uC0DD\uD569\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b>
    \\n \uC678\uBD80 \uCEE8\uD2B8\uB864\uB7EC \uC7A5\uBE44\uC640\uC758 \uD638\uD658\uC131\uC744
    \uCD08\uAE30 \uAE30\uD68D\uC5D0 \uBB34\uC870\uAC74 \uD3EC\uD568\uC2DC\uCF1C\uC57C
    \uD569\uB2C8\uB2E4. \\n"
  uiCategory: "\uC2DC\uBBAC\uB808\uC774\uC158"
