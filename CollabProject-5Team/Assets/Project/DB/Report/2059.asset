  title: "\uD2B8\uB7ED \uC6B4\uC804 \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974 \uC81C\uC548\uC11C"
  trait: 0
  startRepo: 1
  grade: 3
  role: 1
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uC2DC\uB3D9 \uBC84\uD2BC\uC744
    \uB204\uB974\uBA74 \uADF8 \uC790\uB9AC\uC5D0\uC11C \uC5D4\uC9C4\uC774 \uD3ED\uBC1C\uD574\uBC84\uB9AC\uB294
    \uACE0\uC7A5\uB09C \uACE0\uBB3C\uCC28 \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974
    \uC81C\uC548. \\n \uCC28\uB7C9\uC758 \uBD80\uD488\uB4E4\uC744 \uD558\uB098\uC529
    \uBD84\uD574\uD558\uACE0 \uC218\uB9AC\uD569\uB2C8\uB2E4. \\n <b>\uAE30\uB300
    \uD6A8\uACFC</b> \\n \uACE0\uC7A5\uB09C \uC790\uB3D9\uCC28\uB97C \uACE0\uCE58\uBA74\uC11C
    \uC790\uB3D9\uCC28\uC758 \uAD6C\uC870\uC5D0 \uB300\uD55C \uC774\uD574\uAC00 \uB192\uC544\uC9C0\uB294
    \uC720\uC775\uD55C \uAC8C\uC784\uC785\uB2C8\uB2E4. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b>
    \\n \uC6B4\uC804 \uAE30\uB2A5\uC740 \uC5C6\uC73C\uBBC0\uB85C \uC0AC\uAE30\uB77C\uACE0
    \uBE44\uD310\uC744 \uBC1B\uC744 \uC218 \uC788\uC9C0\uB9CC \uACF5\uACF5 \uC548\uC804
    \uAC8C\uC784\uC774\uB77C\uACE0 \uC6B0\uAE30\uBA74 \uB429\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b>
    \\n \uC5D4\uC9C4\uC774 \uD130\uC9C8\uB54C \uC0AC\uC7A5\uB2D8 \uBAA9\uC18C\uB9AC\uB85C
    \u201C\uC548\uC804\uC6B4\uC804 \uD558\uC138\uC694!\u201D\uB97C \uB123\uB294 \uAC74
    \uC5B4\uB5A4\uAC00\uC694? \uAC74\uAC15\uD55C \uAC8C\uC784 \uB290\uB08C\uB098\uC9C0
    \uC54A\uB098\uC694? \\n"
  uiCategory: "\uC2DC\uBBAC\uB808\uC774\uC158"
