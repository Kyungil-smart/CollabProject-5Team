  title: "\uB3C4\uC2DC \uAC74\uC124 \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974 \uC81C\uC548\uC11C"
  trait: 10
  startRepo: 1
  grade: 2
  role: 1
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uC608\uC05C \uAC74\uBB3C\uB4E4\uC744
    \uBC30\uCE58\uD574 \uB098\uB9CC\uC758 \uC791\uC740 \uB3C4\uC2DC\uB97C \uB9CC\uB4DC\uB294
    \uC2DC\uD2F0 \uBE4C\uB354 \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974 \uC81C\uC548.
    \\n \uAC1C\uC131 \uB118\uCE58\uB294 \uB79C\uB4DC\uB9C8\uD06C \uAC74\uBB3C\uB4E4\uC744
    \uC9D3\uACE0 \uB3C4\uC2DC\uB97C \uAFB8\uBC09\uB2C8\uB2E4. \\n <b>\uAE30\uB300
    \uD6A8\uACFC</b> \\n \uBCF5\uC7A1\uD55C \uC218\uB3C4\uAD00 \uC5F0\uACB0\uC774\uB098
    \uC804\uAE30 \uC6A9\uB7C9 \uACC4\uC0B0\uC744 \uC0DD\uB7B5\uD574\uC11C \uC9C4\uC785\uC7A5\uBCBD\uC744
    \uB0AE\uCD9C \uC218 \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b>
    \\n \uADF9\uBCF5\uD560 \uC704\uAE30\uAC00 \uBD80\uC871\uD574\uC11C \uC720\uC800\uB4E4\uC774
    \uAE08\uBC29 \uC131\uC7A5\uC744 \uB05D\uB0B4\uACE0 \uC774\uD0C8\uD560 \uC704\uD5D8\uC774
    \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uC544\uAE30\uC790\uAE30\uD55C
    \uB3C4\uC2DC \uAFB8\uBBF8\uAE30 \uAC8C\uC784\uC740 \uB9CE\uC73C\uB2C8\uAE4C\uC694.
    \uC801\uC808\uD788 \uC11E\uC73C\uBA74 \uB429\uB2C8\uB2E4. \\n"
  uiCategory: "\uC2DC\uBBAC\uB808\uC774\uC158"
