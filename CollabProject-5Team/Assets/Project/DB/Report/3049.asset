  title: "\uD53D\uC140/\uB3C4\uD2B8 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 23
  startRepo: 1
  grade: 2
  role: 2
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uD53D\uC140 \uC544\uD2B8 \uC804\uBB38
    \uC2A4\uD29C\uB514\uC624\uC758 \uC81C\uC791 \uC0AC\uC591\uC744 \uBCA4\uCE58\uB9C8\uD0B9\uD558\uC5EC
    \uD45C\uC900 \uB9AC\uC18C\uC2A4 \uB9AC\uC2A4\uD2B8\uB97C \uB9CC\uB4E4\uACE0,
    \\n \uC77C\uBC18\uC801\uC778 UI \uAD6C\uC131 \uAC00\uC774\uB4DC\uB97C \uC81C\uC791\uD569\uB2C8\uB2E4.
    \uCCB4\uACC4\uC801\uC778 \uAC1C\uBC1C \uC6B4\uC601\uC744 \uC704\uD568\uC785\uB2C8\uB2E4.
    \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uC548\uC815\uC801\uC778 \uC544\uD2B8
    \uC0DD\uC0B0 \uD30C\uC774\uD504\uB77C\uC778 \uAD6C\uCD95\uC774 \uC608\uC0C1\uB429\uB2C8\uB2E4.
    \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n \uC6B0\uB9AC \uAC8C\uC784\uB9CC\uC758
    \uB3C5\uC790\uC801\uC778 \uC544\uD2B8 \uC0C9\uAE54\uC774 \uBD80\uC871\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uBCA4\uCE58\uB9C8\uD0B9\uC744
    \uD1B5\uD574 \uD53D\uC140 \uD45C\uC900 \uC0AC\uC591\uC5D0 \uB9DE\uCDB0 \uAE30\uBCF8\uC744
    \uAD6C\uC131\uD588\uC2B5\uB2C8\uB2E4. \\n"
  uiCategory: "\uD53D\uC140/\uB3C4\uD2B8"
