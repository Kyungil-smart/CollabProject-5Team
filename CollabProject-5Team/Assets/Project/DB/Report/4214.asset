  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b>\\n \uC791\uC740 \uAE30\uB2A5 \uB2E8\uC704\uB85C
    \uB04A\uC5B4 \uBD99\uC77C \uC218 \uC788\uC5B4 \uC77C\uC815 \uAD00\uB9AC\uC5D0
    \uC720\uB9AC\uD55C \uC5D4\uC9C4\uC785\uB2C8\uB2E4..\\n <b>\uAE30\uB300 \uD6A8\uACFC</b>\\n
    \uC791\uC5C5 \uBC94\uC704 \uC870\uC808\uC774 \uC26C\uC6CC\uC9D1\uB2C8\uB2E4.\\n
    <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b>\\n \uAE30\uB2A5\uC774 \uC313\uC774\uBA74
    \uC815\uB9AC\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4.\\n <b>\uCF54\uBA58\uD2B8</b>\\n
    \uC77C\uC815\uB3C4 \uAD00\uB9AC\uD574\uC57C \uD569\uB2C8\uB2E4.\\n"
  uiCategory: "\uAC8C\uC784 \uBA54\uC774\uCEA3"
