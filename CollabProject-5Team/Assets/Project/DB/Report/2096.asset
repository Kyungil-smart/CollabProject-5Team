  title: "\uD3B8\uC758\uC810 \uACBD\uC601 \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974
    \uC81C\uC548\uC11C"
  trait: 6
  startRepo: 1
  grade: 1
  role: 1
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uD2B8\uB80C\uB4DC\uC5D0 \uB9DE\uB294
    \uC0C1\uD488 \uBC1C\uC8FC, \uB9E4\uB300 \uBC30\uCE58, \uC54C\uBC14\uC0DD \uACE0\uC6A9\uC744
    \uC720\uAE30\uC801\uC73C\uB85C \uC81C\uC5B4\uD558\uB294 \uACBD\uC601 \uC2DC\uBBAC\uB808\uC774\uC158
    \uC7A5\uB974 \uC81C\uC548. \\n \uB9E4\uC7A5\uC758 \uB9E4\uCD9C \uD6A8\uC728\uC744
    \uADF9\uB300\uD654\uD558\uB294 \uD3B8\uC758\uC810 \uC6B4\uC601\uC785\uB2C8\uB2E4.
    \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uCE5C\uC219\uD55C \uACF5\uAC04\uC774\uB77C
    \uC9C4\uC785\uC7A5\uBCBD\uC774 \uB0AE\uACE0, \uB098\uB9CC\uC758 \uD3B8\uC758\uC810\uC744
    \uC131\uC7A5\uC2DC\uD0A4\uB294 \uC911\uB3C5\uC131\uC774 \uC788\uC744 \uAC81\uB2C8\uB2E4.
    \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n \uC720\uC800\uAC00 \uC0C1\uD488
    \uD310\uB9E4\uC640 \uBC1C\uC8FC\uC758 \uC801\uB2F9\uD55C \uBC38\uB7F0\uC2A4\uB97C
    \uC720\uC9C0\uD560 \uC218 \uC788\uB3C4\uB85D \uB3C4\uC640\uC918\uC57C \uD569\uB2C8\uB2E4.
    \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uC694\uC998 SNS\uC5D0\uC11C \uC720\uD589\uD558\uB294
    \uC0C1\uD488\uC744 \uC624\uB9C8\uC8FC\uD574\uBCF4\uBA74 \uB354 \uBC14\uC774\uB7F4
    \uB418\uC9C0 \uC54A\uC744\uAE4C\uC694? \\n"
  uiCategory: "\uC2DC\uBBAC\uB808\uC774\uC158"
