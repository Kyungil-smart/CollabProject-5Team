  title: "\uD578\uB4DC\uD398\uC778\uD305 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uC81C\uC548
    \uBCF4\uACE0\uC11C"
  trait: 26
  startRepo: 1
  grade: 3
  role: 2
  content: "\uC81C\uC548\uB0B4\uC6A9 \uD45C\uC900\uD654\uB41C \uD578\uB4DC\uD398\uC778\uD305
    \uBE44\uC8FC\uC5BC \uC544\uC774\uB374\uD2F0\uD2F0\uC640 \uD575\uC2EC \uCEEC\uB7EC
    \uD1A4\uC564\uB9E4\uB108\uB97C \uC0AC\uC6A9\uD558\uC5EC  \uACF5\uC815\uC744 \uAC04\uC18C\uD654\uD558\uACE0
    \uAE30\uD55C \uB0B4 \uACB0\uACFC\uB97C \uB3C4\uCD9C\uD569\uB2C8\uB2E4. \uAE30\uB300\uD6A8\uACFC
    \uD6A8\uC728 \uC911\uC2EC \uACF5\uC815\uC73C\uB85C \uD504\uB85C\uC81D\uD2B8 \uAE30\uD55C
    \uB0B4 \uC131\uACFC\uB97C \uB2EC\uC131\uD569\uB2C8\uB2E4. \uC608\uC0C1 \uB9AC\uC2A4\uD06C
    \uC218\uC791\uC5C5 \uD2B9\uC720\uC758 \uC12C\uC138\uD55C \uB514\uD14C\uC77C \uC694\uC18C\uAC00
    \uC0DD\uB7B5\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCF54\uBA58\uD2B8 \uC8FC\uC5B4\uC9C4
    \uC2DC\uAC04 \uB0B4 \uCD5C\uC120\uC758 \uACB0\uACFC\uBB3C\uC744 \uB0B4\uB3C4\uB85D
    \uB178\uB825\uD588\uC2B5\uB2C8\uB2E4. \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
  uiCategory: "\uD578\uB4DC\uD398\uC778\uD305"
