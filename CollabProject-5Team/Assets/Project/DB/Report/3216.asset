  title: "\uD53D\uC140/\uB3C4\uD2B8 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 32
  startRepo: 1
  grade: 1
  role: 2
  content: "\uC81C\uC548 \uB0B4\uC6A9 \uD53D\uC140 \uB2E8\uC704\uC758 \uC815\uBC00\uD55C
    \uC870\uC815\uC744 \uD1B5\uD574 \uBD88\uD544\uC694\uD55C \uC815\uBCF4\uB97C \uC81C\uAC70\uD558\uACE0,
    \uD544\uC218 \uC778\uD130\uD398\uC774\uC2A4 \uC694\uC18C\uC5D0  \uC138\uBC00\uD55C
    \uBB18\uC0AC\uB97C \uC9D1\uC911\uC2DC\uCF1C \uAC00\uB3C5\uC131\uACFC \uB514\uD14C\uC77C\uC744
    \uB3D9\uC2DC\uC5D0 \uD655\uBCF4\uD569\uB2C8\uB2E4. \uD55C\uC815 \uB9AC\uC18C\uC2A4\uC758
    \uBC00\uB3C4\uB97C \uCD5C\uC801\uD654\uD558\uAE30 \uC704\uD568\uC785\uB2C8\uB2E4.
    \uAE30\uB300 \uD6A8\uACFC \uC2DC\uAC01\uC801 \uBA85\uB8CC\uD568\uACFC \uB192\uC740
    \uB514\uD14C\uC77C \uC218\uC900\uC774 \uC608\uC0C1\uB429\uB2C8\uB2E4. \uC608\uC0C1
    \uB9AC\uC2A4\uD06C \uCD5C\uC18C\uD55C\uC758 \uC815\uBCF4 \uC804\uB2EC\uC744 \uC704\uD55C
    \uAE30\uC220\uC801 \uC81C\uC57D\uC774 \uC788\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uCF54\uBA58\uD2B8 \uD53D\uC140 \uD558\uB098\uD558\uB098\uC758 \uB514\uD14C\uC77C\uC744
    \uC0B4\uB9AC\uBA74\uC11C\uB3C4 \uD654\uBA74\uC744 \uAE54\uB054\uD558\uAC8C \uC815\uB9AC\uD588\uC2B5\uB2C8\uB2E4."
  uiCategory: "\uD53D\uC140/\uB3C4\uD2B8"
