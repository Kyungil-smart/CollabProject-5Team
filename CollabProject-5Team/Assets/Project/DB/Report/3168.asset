  title: "\uD578\uB4DC\uD398\uC778\uD305 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uC81C\uC548
    \uBCF4\uACE0\uC11C"
  trait: 29
  startRepo: 1
  grade: 1
  role: 2
  content: "\uC81C\uC548\uB0B4\uC6A9 \uAC10\uC131\uC801 \uBE44\uC8FC\uC5BC \uC544\uC774\uB374\uD2F0\uD2F0\uC640
    \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uB97C \uC5F0\uAD6C\uD574 \uBCF4\uC644\uD569\uB2C8\uB2E4.
    \uC218\uC791\uC5C5 \uC9C8\uAC10\uC774 \uB290\uAEF4\uC9C0\uB294 \uD48D\uBD80\uD55C
    \uD14D\uC2A4\uCC98\uB97C \uAD6C\uD604\uD558\uACE0 \uC608\uC220\uC131\uC744 \uADF9\uB300\uD654\uD558\uACA0\uC2B5\uB2C8\uB2E4.
    \uAE30\uB300\uD6A8\uACFC \uB3C5\uBCF4\uC801\uC778 \uD68C\uD654\uC801 \uC9C8\uAC10\uC774
    \uC544\uD2B8\uC758 \uC608\uC220\uC131\uC744 \uAC15\uD654\uD569\uB2C8\uB2E4. \uC608\uC0C1
    \uB9AC\uC2A4\uD06C \uD14D\uC2A4\uCC98 \uC218\uC791\uC5C5\uC5D0 \uB530\uB978 \uCD08\uAE30
    \uC81C\uC791 \uC2DC\uAC04\uC774 \uC18C\uC694\uB429\uB2C8\uB2E4. \uCF54\uBA58\uD2B8
    \uD578\uB4DC\uD398\uC778\uD305\uB9CC\uC758 \uAE4A\uC774 \uC788\uB294 \uC544\uD2B8
    \uAD6C\uD604\uC740 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C? "
  uiCategory: "\uD578\uB4DC\uD398\uC778\uD305"
