  title: "\uD53D\uC140/\uB3C4\uD2B8 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 29
  startRepo: 1
  grade: 2
  role: 2
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uD53D\uC140 \uBE44\uC8FC\uC5BC
    \uC544\uC774\uB374\uD2F0\uD2F0\uC640 \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uB97C
    \uC9C0\uD0A4\uBA70 \uC5F0\uCD9C\uC744 \uB2E4\uB4EC\uC2B5\uB2C8\uB2E4. \\n \uAE30\uBCF8\uC801\uC778
    \uC5D0\uC14B \uAD6C\uC131\uC5D0 \uCDA9\uC2E4\uD558\uC5EC \uD654\uBA74\uC774 \uBE44\uC5B4
    \uBCF4\uC774\uC9C0 \uC54A\uAC8C \uD6A8\uACFC\uB97C \uBCF4\uAC15\uD558\uACA0\uC2B5\uB2C8\uB2E4.
    \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uC815\uB9BD\uB41C \uAC00\uC774\uB4DC\uC5D0
    \uB530\uB77C \uC77C\uAD00\uC131 \uC788\uB294 \uD53D\uC140 \uACB0\uACFC\uBB3C\uC744
    \uB9CC\uB4ED\uB2C8\uB2E4. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n \uCD08\uAE30
    \uB2E8\uACC4\uC5D0\uC11C \uC758\uB3C4\uCE58 \uC54A\uC740 \uC5F0\uCD9C \uD004\uB9AC\uD2F0
    \uD3B8\uCC28\uAC00 \uC0DD\uAE38 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b>
    \\n \uAC00\uC774\uB4DC\uB97C \uBC14\uD0D5\uC73C\uB85C \uAF3C\uAF3C\uD788 \uC791\uC5C5\uD588\uC2B5\uB2C8\uB2E4.
    \uD655\uC778 \uBD80\uD0C1\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4. \\n"
  uiCategory: "\uD53D\uC140/\uB3C4\uD2B8"
