  title: "\uD53D\uC140/\uB3C4\uD2B8 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 32
  startRepo: 1
  grade: 2
  role: 2
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uD53D\uC140 \uADF8\uB798\uD53D
    \uC0AC\uC591\uC5D0 \uB9DE\uB294 \uD45C\uC900 \uBAA8\uB378\uB9C1 \uAC00\uC774\uB4DC\uC640
    \uD574\uC0C1\uB3C4\uB97C \uC124\uC815\uD558\uACE0, \uC804\uCCB4 \uC2DC\uC2A4\uD15C\uC758
    \uBC94\uC6A9\uC801\uC778  \\n UI \uC640\uC774\uC5B4\uD504\uB808\uC784\uC744 \uC81C\uC791\uD558\uC5EC
    \uC77C\uAD00\uC131\uC744 \uC720\uC9C0\uD569\uB2C8\uB2E4. \uAC1C\uBC1C \uC0DD\uC0B0\uC131\uC744
    \uC704\uD568\uC785\uB2C8\uB2E4. \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uAC1C\uBC1C
    \uC0DD\uC0B0\uC131 \uBC0F \uC544\uD2B8 \uB9AC\uC18C\uC2A4 \uD1B5\uC77C\uC131\uC774
    \uC608\uC0C1\uB429\uB2C8\uB2E4. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n
    \uB3C5\uCC3D\uC801\uC778 \uD53D\uC140 \uC5F0\uCD9C\uC774 \uB2E4\uC18C \uC81C\uD55C\uC801\uC77C
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uD45C\uC900
    \uC0AC\uC591\uC744 \uC900\uC218\uD558\uC5EC \uAC1C\uBC1C\uC5D0 \uCC28\uC9C8 \uC5C6\uB3C4\uB85D
    \uC81C\uC791\uD588\uC2B5\uB2C8\uB2E4. \\n"
  uiCategory: "\uD53D\uC140/\uB3C4\uD2B8"
