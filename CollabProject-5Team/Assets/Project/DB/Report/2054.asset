  title: "\uB3C4\uC2DC \uAC74\uC124 \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974 \uC81C\uC548\uC11C"
  trait: 10
  startRepo: 1
  grade: 1
  role: 1
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uC8FC\uAC70\xB7\uC0C1\uC5C5\xB7\uACF5\uC5C5
    \uC9C0\uAD6C\uB97C \uC9C0\uC815\uD558\uBA70 \uC790\uC2E0\uC774 \uC6D0\uD558\uB294
    \uB3C4\uC2DC\uB97C \uAC74\uC124\uD558\uB294 \uC2DC\uBBAC\uB808\uC774\uC158 \uC7A5\uB974
    \uC81C\uC548. \\n \uC0C1\uD558\uC218\uB3C4 \uC778\uD504\uB77C\uB97C \uAD6C\uCD95\uD558\uBA70
    \uB3C4\uC2DC\uC758 \uACBD\uC81C\uC640 \uC138\uAE08 \uC218\uCE58\uB97C \uCD5C\uC801\uD654\uD574
    \uB098\uAC11\uB2C8\uB2E4. \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uD558\uB4DC\uCF54\uC5B4
    \uC720\uC800\uCE35\uC758 \uACE0\uC815\uC218\uC694\uAC00 \uD655\uC2E4\uD569\uB2C8\uB2E4.
    \uD50C\uB808\uC774 \uD0C0\uC784 \uB610\uD55C \uC555\uB3C4\uC801 \uC785\uB2C8\uB2E4.
    \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n \uC138\uAE08 \uC218\uCE58 \uACF5\uC2DD\uC774
    \uAF2C\uC774\uBA74 \uB3C4\uC2DC\uAC00 \uD30C\uC0B0\uD558\uB294 \uC77C\uC774 \uC77C\uC5B4\uB0A0\uC9C0\uB3C4
    \uBAA8\uB985\uB2C8\uB2E4.. \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uCD08\uAE30 \uAE30\uD68D
    \uB2E8\uACC4\uBD80\uD130 \uACBD\uC81C \uC54C\uACE0\uB9AC\uC998\uC744 \uC815\uAD50\uD558\uAC8C
    \uB2E4\uB4EC\uC5B4\uC57C \uD569\uB2C8\uB2E4. \\n"
  uiCategory: "\uC2DC\uBBAC\uB808\uC774\uC158"
