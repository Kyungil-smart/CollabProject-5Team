  title: "\uD53D\uC140/\uB3C4\uD2B8 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 26
  startRepo: 1
  grade: 3
  role: 2
  content: "\uC81C\uC548\uB0B4\uC6A9 \uD53D\uC140 \uBE44\uC8FC\uC5BC \uC544\uC774\uB374\uD2F0\uD2F0\uC640
    \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uB97C \uB2E8\uC21C \uC801\uC6A9\uD558\uC5EC
    \uACF5\uC815\uC744 \uAC04\uC18C\uD654\uD558\uACE0 \uB9AC\uC2A4\uD06C\uB97C \uCD5C\uC18C\uD654\uD558\uACA0\uC2B5\uB2C8\uB2E4.
    \uAE30\uB300\uD6A8\uACFC \uC81C\uC791 \uD6A8\uC728 \uC911\uC2EC\uC758 \uD504\uB85C\uC138\uC2A4\uB85C
    \uC5C5\uBB34 \uC18D\uB3C4\uB97C \uAC1C\uC120\uD569\uB2C8\uB2E4. \uC608\uC0C1
    \uB9AC\uC2A4\uD06C \uD45C\uD604\uC758 \uB2E8\uC21C\uD654\uB85C \uC778\uD574 \uBE44\uC8FC\uC5BC\uC758
    \uAC1C\uC131\uC774 \uC77C\uBD80 \uC0C1\uC2E4\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uCF54\uBA58\uD2B8 \uAE30\uD55C\uC744 \uC900\uC218\uD558\uAE30 \uC704\uD574 \uD6A8\uC728\uC801\uC73C\uB85C
    \uC791\uC5C5\uD558\uB3C4\uB85D \uB178\uB825\uD588\uC2B5\uB2C8\uB2E4. \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
  uiCategory: "\uD53D\uC140/\uB3C4\uD2B8"
