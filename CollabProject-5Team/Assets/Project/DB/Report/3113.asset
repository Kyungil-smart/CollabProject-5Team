  title: "\uD53D\uC140/\uB3C4\uD2B8 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 27
  startRepo: 1
  grade: 3
  role: 2
  content: "\uC81C\uC548\uB0B4\uC6A9 \uD53D\uC140 \uBE44\uC8FC\uC5BC \uC544\uC774\uB374\uD2F0\uD2F0\uC640
    \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uB97C \uB2E8\uC21C \uC801\uC6A9\uD558\uC5EC
    \uC5D0\uC14B\uC744 \uB9CC\uB4ED\uB2C8\uB2E4.  \uD6A8\uC728\uC131\uC744 \uC6B0\uC120\uD558\uC5EC
    \uC81C\uC791 \uACF5\uC815\uC744 \uCD5C\uB300\uD55C \uAC04\uC18C\uD654\uD558\uACA0\uC2B5\uB2C8\uB2E4.
    \uAE30\uB300\uD6A8\uACFC \uC81C\uC791 \uD6A8\uC728 \uC911\uC2EC\uC758 \uD504\uB85C\uC138\uC2A4\uB85C
    \uC5C5\uBB34 \uC18D\uB3C4\uB97C \uAC1C\uC120\uD569\uB2C8\uB2E4. \uC608\uC0C1
    \uB9AC\uC2A4\uD06C \uD53D\uC140 \uD2B9\uC720\uC758 \uC815\uAD50\uD55C \uB514\uD14C\uC77C\uC774
    \uC0DD\uB7B5\uB418\uC5B4 \uBCF4\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCF54\uBA58\uD2B8
    \uAE30\uD55C\uC744 \uC900\uC218\uD558\uAE30 \uC704\uD574 \uD6A8\uC728\uC801\uC73C\uB85C
    \uC791\uC5C5\uD588\uC2B5\uB2C8\uB2E4. \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4. "
  uiCategory: "\uD53D\uC140/\uB3C4\uD2B8"
