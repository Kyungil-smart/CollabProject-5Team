  title: "\uB9AC\uC5BC\uB9AC\uC998 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uC81C\uC548 \uBCF4\uACE0\uC11C"
  trait: 28
  startRepo: 1
  grade: 2
  role: 2
  content: "\uC81C\uC548\uB0B4\uC6A9 \uC2E4\uC0AC\uD48D \uBE44\uC8FC\uC5BC \uC544\uC774\uB374\uD2F0\uD2F0\uC640
    \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108 \uAC00\uC774\uB4DC\uB97C \uC124\uC815\uD558\uACE0
    \uC548\uC815\uC801\uC778 \uC5F0\uCD9C\uC744 \uC218\uD589\uD569\uB2C8\uB2E4. \uB2E8\uACC4\uC801
    \uC791\uC5C5\uC744 \uD1B5\uD574 \uC2E4\uC0AC \uC544\uD2B8\uC758 \uAE30\uC900\uC744
    \uB9DE\uCD94\uACA0\uC2B5\uB2C8\uB2E4. \uAE30\uB300\uD6A8\uACFC \uC2A4\uD0C0\uC77C
    \uAC00\uC774\uB4DC \uC900\uC218\uB85C \uD45C\uC900 \uC2E4\uC0AC \uC544\uD2B8\uB97C
    \uC644\uC131\uD569\uB2C8\uB2E4. \uC608\uC0C1 \uB9AC\uC2A4\uD06C \uCD5C\uC801\uD654
    \uACFC\uC815\uC5D0\uC11C \uC2E4\uC0AC \uC5F0\uCD9C\uC758 \uAE4A\uC774\uAC10\uC774
    \uC904\uC5B4\uB4E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCF54\uBA58\uD2B8 \uC0AC\uC2E4\uC801\uC778
    \uC544\uD2B8 \uAC00\uC774\uB4DC\uB97C \uCDA9\uC2E4\uD788 \uC774\uD589\uD558\uB3C4\uB85D
    \uB178\uB825\uD588\uC2B5\uB2C8\uB2E4."
  uiCategory: "\uB9AC\uC5BC\uB9AC\uC998"
