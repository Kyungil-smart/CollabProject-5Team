  title: "\uCE74\uD230\uD48D \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 32
  startRepo: 1
  grade: 2
  role: 2
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uCE74\uD230\uD48D \uADF8\uB798\uD53D\uC758
    \uD45C\uC900 \uD3F4\uB9AC\uACE4 \uC218\uC640 \uD14D\uC2A4\uCC98 \uD574\uC0C1\uB3C4\uB97C
    \uC124\uC815\uD558\uACE0, \uAE30\uBCF8\uC801\uC778 \uC870\uC791 \uC778\uD130\uD398\uC774\uC2A4 
    \\n \uBE44\uC8FC\uC5BC \uAC00\uC774\uB4DC\uB97C \uC791\uC131\uD558\uC5EC \uD1B5\uC77C\uB41C
    \uC544\uD2B8 \uD658\uACBD\uC744 \uAD6C\uCD95\uD569\uB2C8\uB2E4. \uAC1C\uBC1C
    \uD1B5\uC77C\uC131\uC744 \uC704\uD568\uC785\uB2C8\uB2E4. \\n <b>\uAE30\uB300
    \uD6A8\uACFC</b> \\n \uAC1C\uBC1C \uC77C\uC815 \uC900\uC218\uC640 \uC548\uC815\uC801\uC778
    \uC544\uD2B8 \uD1B5\uC77C\uC131\uC774 \uC608\uC0C1\uB429\uB2C8\uB2E4. \\n <b>\uC608\uC0C1
    \uB9AC\uC2A4\uD06C</b> \\n \uB514\uD14C\uC77C\uD55C \uAC1C\uC131\uC774 \uB2E4\uC18C
    \uBD80\uC871\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b>
    \\n \uD45C\uC900 \uAC00\uC774\uB4DC\uB77C\uC778\uC5D0 \uB530\uB77C \uAE30\uBCF8\uC5D0
    \uCDA9\uC2E4\uD558\uAC8C \uC900\uBE44\uD588\uC2B5\uB2C8\uB2E4. \\n"
  uiCategory: "\uCE74\uD230\uD48D"
