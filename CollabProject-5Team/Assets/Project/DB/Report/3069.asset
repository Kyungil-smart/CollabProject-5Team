  title: "\uD53D\uC140/\uB3C4\uD2B8 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 25
  startRepo: 1
  grade: 1
  role: 2
  content: "\uC81C\uC548\uB0B4\uC6A9 \uD53D\uC140\uC758 \uBE44\uC8FC\uC5BC \uC544\uC774\uB374\uD2F0\uD2F0\uC640
    \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uB97C \uC644\uBCBD\uD788 \uC815\uB9BD\uD558\uC5EC, 
    \uB3C4\uD2B8 \uD558\uB098\uD558\uB098\uC5D0 \uBC00\uB3C4 \uB192\uC740 \uB514\uD14C\uC77C\uC744
    \uB2F4\uC544\uB0B4\uACE0 \uB3C5\uBCF4\uC801\uC778 \uB808\uD2B8\uB85C \uBE44\uC8FC\uC5BC\uC744
    \uAD6C\uCD95\uD558\uB294 \uC81C\uC791 \uBC29\uC2DD\uC744 \uC81C\uC548\uD569\uB2C8\uB2E4.
    \uAE30\uB300\uD6A8\uACFC \uB3C5\uBCF4\uC801\uC778 \uD53D\uC140 \uC2A4\uD0C0\uC77C\uB85C
    \uBE0C\uB79C\uB4DC \uAC00\uCE58\uAC00 \uADF9\uB300\uD654\uB429\uB2C8\uB2E4. \uC608\uC0C1
    \uB9AC\uC2A4\uD06C \uC815\uAD50\uD55C \uC791\uC5C5\uC73C\uB85C \uCD08\uAE30 \uC544\uD2B8
    \uC5D0\uC14B \uC81C\uC791 \uC77C\uC815\uC774 \uB2A6\uC5B4\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uCF54\uBA58\uD2B8 \uB290\uB9AC\uC9C0\uB9CC \uC644\uBCBD\uD55C \uD53D\uC140 \uC544\uD2B8\uB97C
    \uAD6C\uD604\uD558\uB294 \uAC74 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C? \uCD5C\uC120\uC744
    \uB2E4\uD574 \uC900\uBE44\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  uiCategory: "\uD53D\uC140/\uB3C4\uD2B8"
