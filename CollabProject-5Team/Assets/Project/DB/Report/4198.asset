  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b>\\n \uBE60\uB978 \uAE30\uB2A5 \uAD6C\uD604\uACFC
    \uC989\uC2DC \uD655\uC778\uC774 \uC911\uC694\uD55C \uD504\uB85C\uC81D\uD2B8\uC5D0
    \uC801\uD569\uD55C \uC5D4\uC9C4\uC785\uB2C8\uB2E4.\\n <b>\uAE30\uB300 \uD6A8\uACFC</b>\\n
    \uC81C\uC791 \uC18D\uB3C4\uC640 \uC218\uC815 \uD6A8\uC728\uC774 \uB192\uC544\uC9D1\uB2C8\uB2E4.\\n
    <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b>\\n \uB300\uADDC\uBAA8 \uD655\uC7A5 \uC2DC
    \uAD6C\uC870 \uAD00\uB9AC\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4.\\n <b>\uCF54\uBA58\uD2B8</b>\\n
    \uC791\uAC8C \uB9CC\uB4E4\uBA74 \uBE60\uB974\uAC8C \uACE0\uCE69\uB2C8\uB2E4.\\n"
  uiCategory: "\uAC8C\uC784 \uBA54\uC774\uCEA3"
