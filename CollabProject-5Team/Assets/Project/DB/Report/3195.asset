  title: "\uD53D\uC140/\uB3C4\uD2B8 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 31
  startRepo: 1
  grade: 1
  role: 2
  content: "\uC81C\uC548\uB0B4\uC6A9 \uD53D\uC140 \uBE44\uC8FC\uC5BC \uC544\uC774\uB374\uD2F0\uD2F0\uC640
    \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uB97C \uBCF4\uC644\uD558\uACE0, 
    \uB3C4\uD2B8 \uBC00\uB3C4\uB97C \uC870\uC815\uD558\uC5EC \uC2DC\uC120\uC744 \uC9D1\uC911\uC2DC\uD0A4\uB294
    \uAD6C\uB3C4\uB97C \uC644\uC131\uD558\uC5EC \uD654\uBA74\uC758 \uBA85\uD655\uC131\uC744
    \uB192\uC785\uB2C8\uB2E4. \uAE30\uB300\uD6A8\uACFC \uC815\uB3C8\uB41C \uD53D\uC140
    \uBC30\uCE58\uB97C \uD1B5\uD574 \uAC8C\uC784 \uD654\uBA74\uC758 \uC2DC\uAC01\uC801
    \uD488\uC9C8\uC744 \uADF9\uC801\uC73C\uB85C \uAC1C\uC120\uD569\uB2C8\uB2E4. \uC608\uC0C1
    \uB9AC\uC2A4\uD06C \uD53D\uC140 \uC704\uCE58\uB97C \uC815\uBC00\uD558\uAC8C \uC218\uC815\uD558\uB294
    \uC791\uC5C5\uC73C\uB85C \uC778\uD574 \uC5D0\uC14B \uC81C\uC791 \uC2DC\uAC04\uC774
    \uAE38\uC5B4\uC9D1\uB2C8\uB2E4. \uCF54\uBA58\uD2B8 \uD53D\uC140 \uD654\uBA74\uC758
    \uC0B0\uB9CC\uD568\uC744 \uC815\uB3C8\uD558\uC5EC \uC644\uC131\uB3C4\uB97C \uB192\uC5EC\uBCF4\uB294
    \uAC74 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?"
  uiCategory: "\uD53D\uC140/\uB3C4\uD2B8"
