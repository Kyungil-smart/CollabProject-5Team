  content: "\uC81C\uC548 \uB0B4\uC6A9 3D \uB9AC\uC18C\uC2A4 \uC81C\uC791 \uC2DC \uBAA8\uB4C8\uD654\uB41C
    \uD30C\uCE20\uB97C \uD65C\uC6A9\uD574 \uC791\uC5C5 \uC18D\uB3C4\uB97C \uB192\uC774\uACE0,
    \uD45C\uC900\uD654\uB41C \uD3F4\uB9AC\uACE4  \uAC00\uC774\uB4DC\uB97C \uC801\uC6A9\uD558\uC5EC
    \uB9AC\uC18C\uC2A4 \uC7AC\uC0AC\uC6A9\uC131\uC744 \uB192\uC5EC \uC81C\uC791 \uD6A8\uC728\uC744
    \uADF9\uB300\uD654\uD569\uB2C8\uB2E4. \uB2E4\uC791\uC744 \uC704\uD55C \uD658\uACBD
    \uAD6C\uCD95\uC744 \uC704\uD568\uC785\uB2C8\uB2E4. \uAE30\uB300 \uD6A8\uACFC
    \uB9AC\uC18C\uC2A4 \uC81C\uC791 \uC18D\uB3C4 \uD5A5\uC0C1 \uBC0F \uAC1C\uBC1C
    \uBE44\uC6A9 \uC808\uAC10\uC774 \uC608\uC0C1\uB429\uB2C8\uB2E4. \uC608\uC0C1
    \uB9AC\uC2A4\uD06C \uCD08\uAE30 \uBAA8\uB4C8 \uC124\uACC4 \uACF5\uC218\uB85C
    \uC778\uD55C \uC77C\uC815 \uC9C0\uC5F0\uC774 \uC788\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uCF54\uBA58\uD2B8 \uC791\uC5C5 \uD6A8\uC728\uC744 \uCD5C\uB300\uD55C \uB04C\uC5B4\uC62C\uB9AC\uB294
    \uBC29\uD5A5\uC73C\uB85C \uC124\uACC4\uB97C \uC7A1\uC544\uBCF4\uC558\uC2B5\uB2C8\uB2E4."
