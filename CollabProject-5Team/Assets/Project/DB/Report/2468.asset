  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uAE30\uC874 \uC131\uACF5\uC791\uB4E4\uC758
    \uC5D0\uC14B\uACFC \uD074\uB9AC\uC170\uB97C \uD574\uCCB4 \uC7AC\uC870\uD569\uD55C
    \uBA54\uD0C0 \uC5B4\uB4DC\uBCA4\uCC98 \uC81C\uC548. \\n \uC775\uC219\uD55C \uC11C\uC0AC
    \uAD6C\uC870\uB97C \uC5ED\uC774\uC6A9\uD574 \uC2EC\uB9AC\uC801 \uC548\uC815\uAC10\uC744
    \uC90D\uB2C8\uB2E4. \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uD074\uB9AC\uC170\uB97C
    \uB4A4\uC5CE\uC740 \uD601\uC2E0\uC801\uC778 \uC5B4\uB4DC\uBCA4\uCC98 \uAC8C\uC784\uC73C\uB85C
    \uC785\uC18C\uBB38\uC744 \uD0C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uC608\uC0C1
    \uB9AC\uC2A4\uD06C</b> \\n \uC5B4\uB514\uC120\uAC00 \uBCF8\uB4EF\uD55C \uB9AC\uC18C\uC2A4\uB4E4\uC5D0
    \uCF54\uC5B4 \uC720\uC800\uB4E4\uC774 \uC2E4\uB9DD\uD558\uBA70 \uC774\uD0C8\uD560
    \uC6B0\uB824\uAC00 \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b> \\n
    \uC775\uC219\uD568 \uC18D\uC5D0\uC11C \uBBF8\uC138\uD55C \uBCC0\uC8FC\uB97C \uC8FC\uC5B4
    \uAC00\uC7A5 \uC548\uC815\uC801\uC778 \uD765\uD589\uC744 \uBCF4\uC7A5\uD569\uB2C8\uB2E4.
    \\n"
  uiCategory: "\uC5B4\uB4DC\uBCA4\uCC98"
