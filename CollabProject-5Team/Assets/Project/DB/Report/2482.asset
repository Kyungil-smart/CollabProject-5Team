  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uC2DC\uAC01\uACFC \uCCAD\uAC01\uC744
    \uBAA8\uB450 \uCC28\uB2E8\uD574 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uB294 \uCE60\uD751
    \uC18D \uC5B4\uB4DC\uBCA4\uCC98 \uC7A5\uB974 \uC81C\uC548. \\n \uC720\uC800\uC758
    \uC0C1\uC0C1\uB825\uB9CC\uC73C\uB85C \uD654\uBA74 \uBC16\uC758 \uBAA8\uD5D8\uC744
    \uC54C\uC544\uC11C \uC990\uAE30\uB3C4\uB85D \uC720\uB3C4\uD569\uB2C8\uB2E4. \\n
    <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uC544\uD2B8\uC640 \uC0AC\uC6B4\uB4DC \uB9AC\uC18C\uC2A4\uB97C
    0\uC73C\uB85C \uC218\uB834\uC2DC\uCF1C \uAC1C\uBC1C \uC608\uC0B0\uC744 \uC644\uBCBD\uD558\uAC8C
    \uAD73\uD799\uB2C8\uB2E4. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n \uAC80\uC740
    \uD654\uBA74\uB9CC \uB369\uADF8\uB7EC\uB2C8 \uCF1C\uC838 \uC788\uC5B4 \uAE30\uAE30
    \uACE0\uC7A5\uC73C\uB85C \uC624\uD574\uBC1B\uC744 \uC6B0\uB824\uAC00 \uC788\uC2B5\uB2C8\uB2E4.
    \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uC544\uC774\uB514\uC5B4\uAC00 \uB118\uCE58\uB2E4
    \uBABB\uD574 \uBB34\uC758 \uC138\uACC4\uB85C \uCD08\uC6D4\uD574 \uBC84\uB9B0
    \uAD81\uADF9\uC758 \uBBF8\uB2C8\uBA40\uB9AC\uC998\uC785\uB2C8\uB2E4. \\n"
  uiCategory: "\uC5B4\uB4DC\uBCA4\uCC98"
