  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uC624\uB79C \uAE30\uAC04 \uAC80\uC99D\uB41C
    \uC548\uC815\uC801\uC778 \uC5D4\uC9C4\uC785\uB2C8\uB2E4. \\n \uAC80\uC99D\uB41C
    \uC5D4\uC9C4\uC744 \uD65C\uC6A9\uD558\uB294 \uAC83\uC774 \uC801\uD569\uD569\uB2C8\uB2E4.
    \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uAE30\uC874 \uAC1C\uBC1C \uACBD\uD5D8\uC744
    \uD65C\uC6A9\uD558\uC5EC \uD6A8\uC728\uC744 \uB192\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n \uAE30\uC220 \uACBD\uC7C1\uB825\uC774
    \uBD80\uC871\uD574\uC9C8 \uAC00\uB2A5\uC131\uC774 \uC788\uC2B5\uB2C8\uB2E4. \\n
    <b>\uCF54\uBA58\uD2B8</b> \\n \uD654\uB824\uD558\uC9C4 \uC54A\uC9C0\uB9CC \uC548\uC815\uC131
    \uD655\uBCF4\uC5D0 \uAC15\uD55C \uC7A5\uC810\uC774 \uC788\uC2B5\uB2C8\uB2E4.
    \\n"
  uiCategory: "\uCEA3\uC18C\uC2A41"
