  title: "\uCE74\uD230\uD48D \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 26
  startRepo: 1
  grade: 2
  role: 2
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uCE74\uD230\uD48D\uC758 \uBE44\uC8FC\uC5BC
    \uC544\uC774\uB374\uD2F0\uD2F0\uC640 \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uB97C
    \uC124\uC815\uD558\uACE0 \uC810\uC9C4\uC801\uC778 \uC81C\uC791\uC73C\uB85C \uBC94\uC704\uB97C
    \uD655\uC7A5\uD558\uB294 \uBC29\uC2DD\uC744 \uC81C\uC548\uD569\uB2C8\uB2E4. \\n
    <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uC2A4\uD0C0\uC77C\uC744 \uC815\uCC29\uC2DC\uCF1C
    \uC791\uC5C5 \uD6A8\uC728\uC131\uC744 \uC548\uC815\uC801\uC73C\uB85C \uB192\uC77C
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n
    \uCD08\uAE30\uC5D0 \uC2A4\uD0C0\uC77C \uAC00\uC774\uB4DC\uB77C\uC778\uC744 \uC124\uC815\uD558\uB294
    \uACFC\uC815\uC5D0\uC11C \uC2DC\uAC04\uC774 \uC18C\uC694\uB429\uB2C8\uB2E4. \\n
    <b>\uCF54\uBA58\uD2B8</b> \\n \uCC9C\uCC9C\uD788 \uC791\uC5C5\uD558\uBA70 \uACAC\uACE0\uD55C
    \uC2A4\uD0C0\uC77C\uC744 \uB9CC\uB4E4\uC5B4\uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uAC00\uC774\uB4DC\uB97C
    \uC815\uB9AC\uD574 \uC81C\uC548\uB4DC\uB9BD\uB2C8\uB2E4. \\n"
  uiCategory: "\uCE74\uD230\uD48D"
