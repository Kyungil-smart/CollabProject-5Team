  title: "\uC544\uB0A0\uB85C\uADF8 \uC2A4\uD1A0\uB9AC \uC7A5\uB974 \uC81C\uC548\uC11C"
  trait: 5
  startRepo: 1
  grade: 2
  role: 1
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n 2000\uB144\uB300 \uCD08\uBC18 \uC778\uD130\uB137
    \uC18C\uC124\uC758 \uC804\uD615\uC801\uC778 \uD074\uB9AC\uC170\uC640 \uACFC\uC7A5\uB41C
    \uC774\uBAA8\uD2F0\uCF58 \uB300\uC0AC\uB97C \uADF8\uB300\uB85C \uCC28\uC6A9\uD558\uB294
    \uB808\uD2B8\uB85C \uC2A4\uD1A0\uB9AC \uC7A5\uB974 \uC81C\uC548. \\n <b>\uAE30\uB300
    \uD6A8\uACFC</b> \\n \uADF8 \uC2DC\uC808 \uAC10\uC131\uC744 \uC544\uB294 \uC720\uC800\uC5D0\uAC8C\uB294
    \uCD94\uC5B5\uC744, \uC2E0\uADDC \uC720\uC800\uC5D0\uAC8C\uB294 B\uAE09 \uAC10\uC131\uC758
    \uC720\uCF8C\uD568\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4. \\n <b>\uC608\uC0C1
    \uB9AC\uC2A4\uD06C</b> \\n \uC804\uAC1C\uAC00 \uB108\uBB34 \uC9C4\uBD80\uD558\uBA74
    \uCF54\uC5B4 \uC2A4\uD1A0\uB9AC \uAC8C\uC784 \uC720\uC800\uB4E4\uC740 \uAE08\uC138
    \uD765\uBBF8\uB97C \uC783\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b>
    \\n \uC61B\uB0A0 \uAC10\uC131 \uADF8\uB300\uB85C \uBC00\uC5B4\uBD99\uC774\uB294
    \uAC8C \uAE30\uD68D\uD558\uAE30\uB3C4 \uD3B8\uD558\uACE0 \uD0C0\uC728\uB3C4 \uB192\uC2B5\uB2C8\uB2E4.
    \\n"
  uiCategory: "\uC2A4\uD1A0\uB9AC"
