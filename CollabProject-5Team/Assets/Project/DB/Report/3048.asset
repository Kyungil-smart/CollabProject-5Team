  title: "\uD53D\uC140/\uB3C4\uD2B8 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 23
  startRepo: 1
  grade: 1
  role: 2
  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uAE00\uB85C\uBC8C \uD788\uD2B8
    \uD53D\uC140 \uAC8C\uC784\uC758 \uC870\uC791 \uC778\uD130\uD398\uC774\uC2A4\uB97C
    \uBD84\uC11D\uD558\uC5EC \uAC00\uB3C5\uC131\uC744 \uADF9\uB300\uD654\uD55C UI
    \uAC00\uC774\uB4DC\uB97C \uC7AC\uAD6C\uC131\uD558\uACE0, \\n \uC0AC\uC591\uBCC4
    \uD14D\uC2A4\uCC98 \uD574\uC0C1\uB3C4 \uAE30\uC900\uC744 \uBA85\uD655\uD788 \uC124\uC815\uD569\uB2C8\uB2E4.
    \uC0AC\uC6A9\uC790 \uD3B8\uC758\uC131 \uADF9\uB300\uD654\uB97C \uC704\uD568\uC785\uB2C8\uB2E4.
    \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uC9C1\uAD00\uC801\uC774\uACE0 \uC775\uC219\uD55C
    \uD50C\uB808\uC774 \uD658\uACBD \uC81C\uACF5\uC774 \uC608\uC0C1\uB429\uB2C8\uB2E4.
    \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b> \\n \uD0C0 \uAC8C\uC784\uACFC \uC720\uC0AC\uD55C
    \uC778\uD130\uD398\uC774\uC2A4\uB85C \uC778\uD55C \uD45C\uC808 \uB17C\uB780\uC774
    \uC788\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b> \\n
    \uC131\uACF5\uD55C \uD53D\uC140 \uAC8C\uC784\uB4E4\uC758 \uC7A5\uC810\uB9CC \uBAA8\uC544
    \uC6B0\uB9AC \uAC8C\uC784\uC5D0 \uB9DE\uAC8C \uB2E4\uB4EC\uC5C8\uC2B5\uB2C8\uB2E4.
    \\n"
  uiCategory: "\uD53D\uC140/\uB3C4\uD2B8"
