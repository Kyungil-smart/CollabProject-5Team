  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b>\\n \uAD6C\uC870\uAC00 \uBB34\uB108\uC9C8
    \uC704\uD5D8\uC774 \uB192\uC544 \uAC80\uC99D\uB41C \uC5D4\uC9C4\uC73C\uB85C \uAC1C\uBC1C
    \uBC94\uC704\uB97C \uACE0\uC815\uD569\uB2C8\uB2E4.\\n <b>\uAE30\uB300 \uD6A8\uACFC</b>\\n
    \uBD88\uD544\uC694\uD55C \uC218\uC815\uACFC \uBC84\uADF8 \uB204\uC801\uC744 \uC904\uC785\uB2C8\uB2E4.\\n
    <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b>\\n \uCD5C\uC2E0 \uAE30\uB2A5 \uB300\uC751\uB825\uC740
    \uBD80\uC871\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n <b>\uCF54\uBA58\uD2B8</b>\\n
    \uC124\uACC4\uAC00 \uC9C0\uC800\uBD84\uD574\uC9C8\uC218\uB85D \uC0C8 \uAE30\uB2A5\uBCF4\uB2E4
    \uAC80\uC99D\uB41C \uAE30\uBC18\uC774 \uB354 \uC911\uC694\uD569\uB2C8\uB2E4.\\n"
  uiCategory: "\uCEA3\uC18C\uC2A41"
