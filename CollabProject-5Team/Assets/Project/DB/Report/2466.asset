  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uC0C1\uC810\uC758 \uB9E4\uCD9C\uACFC
    \uC9C0\uCD9C \uC218\uCE58\uB9CC \uB2E8\uC21C\uD558\uAC8C \uAD00\uB9AC\uD558\uB294
    \uB300\uC911\uC801 \uACBD\uC601 \uC7A5\uB974 \uC81C\uC548. \\n \uBCF5\uC7A1\uD55C
    \uC138\uAE08 \uACC4\uC0B0\uC744 \uC0DD\uB7B5\uD558\uACE0 \uC9C1\uAD00\uC801\uC778
    \uC22B\uC790 \uC624\uB974\uB0B4\uB9BC\uC758 \uC7AC\uBBF8\uB9CC \uC81C\uACF5\uD569\uB2C8\uB2E4.
    \\n <b>\uAE30\uB300 \uD6A8\uACFC</b> \\n \uC815\uC11D\uC801\uC778 \uC22B\uC790
    \uBD88\uB9AC\uAE30 \uBB38\uBC95\uC744 \uC801\uC6A9\uD558\uC5EC \uC548\uC815\uC801\uC778
    \uC778\uAC8C\uC784 \uC218\uC775\uC744 \uB2EC\uC131\uD569\uB2C8\uB2E4. \\n <b>\uC608\uC0C1
    \uB9AC\uC2A4\uD06C</b> \\n \uBED4\uD55C \uAD6C\uC870 \uD0D3\uC5D0 \uD6C4\uBC18\uBD80\uB85C
    \uAC08\uC218\uB85D \uC720\uC800\uC758 \uD50C\uB808\uC774 \uB3D9\uAE30\uAC00 \uD558\uB77D\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uBA38\uB9AC
    \uC544\uD504\uAC8C \uC7A5\uBD80\uB97C \uD138 \uD544\uC694 \uC5C6\uC774 \uD1B5\uC7A5
    \uC794\uACE0 \uC22B\uC790\uB9CC \uCC29\uC2E4\uD788 \uB298\uB9AC\uBA74 \uB429\uB2C8\uB2E4.
    \\n"
  uiCategory: "\uC2DC\uBBAC\uB808\uC774\uC158"
