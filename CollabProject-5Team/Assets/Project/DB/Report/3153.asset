  title: "\uD53D\uC140/\uB3C4\uD2B8 \uC544\uD2B8 \uC2A4\uD0C0\uC77C \uD504\uB85C\uC81D\uD2B8
    \uC81C\uC548\uC11C"
  trait: 29
  startRepo: 1
  grade: 1
  role: 2
  content: "\uC81C\uC548\uB0B4\uC6A9 \uD53D\uC140 \uBE44\uC8FC\uC5BC \uC544\uC774\uB374\uD2F0\uD2F0\uC640
    \uD575\uC2EC \uCEEC\uB7EC \uD1A4\uC564\uB9E4\uB108\uC5D0 \uB9DE\uCDB0 \uC5F0\uCD9C\uC744
    \uAC1C\uC120\uD569\uB2C8\uB2E4. \uB3C4\uD2B8\uC758 \uBC00\uB3C4\uC640 \uC0C9\uC0C1
    \uC870\uC808\uC744 \uD1B5\uD574 \uD654\uBA74\uC758 \uB2E4\uCC44\uB85C\uC6C0\uC744
    \uADF9\uC801\uC73C\uB85C \uAD6C\uD604\uD558\uC5EC \uC0DD\uBA85\uB825\uC744 \uBD88\uC5B4\uB123\uACA0\uC2B5\uB2C8\uB2E4.
    \uAE30\uB300\uD6A8\uACFC \uC785\uCCB4\uC801\uC778 \uD53D\uC140 \uC5F0\uCD9C\uB85C
    \uBE0C\uB79C\uB4DC\uC758 \uC2DC\uAC01\uC801 \uAC00\uCE58\uB97C \uB192\uC785\uB2C8\uB2E4.
    \uC608\uC0C1 \uB9AC\uC2A4\uD06C \uC815\uBC00\uD55C \uB3C4\uD2B8 \uC218\uC815\uC73C\uB85C
    \uC778\uD574 \uC5D0\uC14B \uC81C\uC791 \uC2DC\uAC04\uC774 \uAE38\uC5B4\uC9C8
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCF54\uBA58\uD2B8 \uD53D\uC140\uC758 \uBC0B\uBC0B\uD568\uC744
    \uBCF4\uC644\uD560 \uAE30\uD68C\uB97C \uC8FC\uC2DC\uB294 \uAC74 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?
    \uB178\uB825\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  uiCategory: "\uD53D\uC140/\uB3C4\uD2B8"
