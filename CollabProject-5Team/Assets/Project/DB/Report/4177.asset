  content: "\uACF5\uD1B5 \uAE30\uB2A5\uC774 \uB9CE\uC740 \uD504\uB85C\uC81D\uD2B8\uC5D0
    \uC801\uD569\uD55C \uC5D4\uC9C4\uC785\uB2C8\uB2E4.\\n \uC7AC\uC0AC\uC6A9 \uAD6C\uC870\uB97C
    \uAD6C\uCD95\uD558\uAE30 \uC26C\uC6B4 \uCEA3\uC18C\uC2A42\uB97C \uCD94\uCC9C\uD569\uB2C8\uB2E4.\\n
    <b>\uAE30\uB300 \uD6A8\uACFC</b>\\n \uC911\uBCF5 \uAC1C\uBC1C\uC744 \uC904\uC77C
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b>\\n
    \uACF5\uD1B5 \uAD6C\uC870 \uC124\uACC4\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4.\\n
    <b>\uCF54\uBA58\uD2B8</b>\\n \uAC19\uC740 \uAE30\uB2A5\uC744 \uC5EC\uB7EC \uBC88
    \uB9CC\uB4DC\uB294 \uAC83\uBCF4\uB2E4 \uD55C \uBC88 \uC798 \uB9CC\uB4DC\uB294
    \uAC83\uC774 \uC88B\uC2B5\uB2C8\uB2E4.\\n"
  uiCategory: "\uCEA3\uC18C\uC2A42"
