  content: "<b>\uC81C\uC548 \uB0B4\uC6A9</b> \\n \uC18C\uB9AC\uC758 \uBC18\uC0AC
    \uD30C\uB3D9\uC73C\uB85C \uC740\uB2C9\uB41C \uC9C0\uD615\uC744 \uD30C\uC545\uD558\uB294
    \uCCAD\uAC01 \uC5B4\uB4DC\uBCA4\uCC98 \uC7A5\uB974 \uC81C\uC548. \\n \uBBF8\uC9C0\uC758
    \uACF5\uAC04\uC744 \uC18C\uB9AC\uB85C \uADF8\uB824\uB0B4\uBA70 \uC0C8\uB85C\uC6B4
    \uD0D0\uD5D8\uC758 \uC9C0\uD3C9\uC744 \uC5FD\uB2C8\uB2E4. \\n <b>\uAE30\uB300
    \uD6A8\uACFC</b> \\n \uB3C5\uCC3D\uC801\uC778 \uACF5\uAC10\uAC01\uC801 \uACBD\uD5D8\uC744
    \uC81C\uACF5\uD574 \uCF54\uC5B4 \uC5B4\uB4DC\uBCA4\uCC98 \uD32C\uB364\uC744 \uD655\uC2E4\uD788
    \uC0AC\uB85C\uC7A1\uC2B5\uB2C8\uB2E4. \\n <b>\uC608\uC0C1 \uB9AC\uC2A4\uD06C</b>
    \\n \uC2DC\uAC01\uC801 \uB2E8\uC11C\uAC00 \uC5C6\uC5B4 \uAE38 \uCC3E\uAE30\uC5D0
    \uD53C\uB85C\uAC10\uC744 \uB290\uB084 \uC6B0\uB824\uAC00 \uC788\uC2B5\uB2C8\uB2E4.
    \\n <b>\uCF54\uBA58\uD2B8</b> \\n \uC218\uB9CE\uC740 \uC18C\uB9AC \uB370\uC774\uD130\uB97C
    \uC870\uD569\uD574 \uCC28\uC6D0\uC774 \uB2E4\uB978 \uBAA8\uD5D8 \uC138\uACC4\uB97C
    \uCC3D\uC870\uD574 \uB0C8\uC2B5\uB2C8\uB2E4. \\n"
  uiCategory: "\uC5B4\uB4DC\uBCA4\uCC98"
