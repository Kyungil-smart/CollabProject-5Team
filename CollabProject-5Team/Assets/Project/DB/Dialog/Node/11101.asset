  desc: "\uB124\uB85C \uC0AC\uC6D0"
  text: "\"\uC774\uBC88\uC5D0 \uC0AC\uB0B4 \uB3D9\uD638\uD68C \uC9C0\uC6D0\uAE08\uC774
    \uB300\uD3ED \uC0C1\uD5A5\uB41C\uB2E4\uB354\uB77C~. \uC0AC\uC7A5\uB2D8\uC774
    \uC6EC\uC77C\uB85C \uC778\uC2EC\uC744 \uC37C\uB098 \uB9C8\uB0E5 \uC2E0\uAE30\uD558\uB2E4\uB354\uB77C~.
    \uC2E0\uC785\uB3C4 \uB098\uB791 \uAC19\uC774 \uBCF4\uB4DC\uAC8C\uC784 \uB3D9\uD638\uD68C
    \uB4E4\uC5B4\uC11C \uC9C0\uC6D0\uAE08\uC73C\uB85C \uBE44\uC2FC \uAC04\uC2DD \uD138\uC5B4\uBA39\uC790\uB354\uB77C~.\""
  choice01: "\"\uC640, \uC0AC\uC7A5\uB2D8\uC774 \uC9C1\uC6D0\uB4E4 \uCE5C\uBAA9 \uB3C4\uBAA8\uB97C
    \uC704\uD574 \uD1B5 \uD070 \uACB0\uC815\uC744 \uD558\uC168\uAD70\uC694\uB0E5\uB0E5!
    \uAC00\uC785\uD558\uACA0\uC2B5\uB2C8\uB2E4\uB0E5\uB0E5!\""
  nextId01: 11102
  choice02: "\"\uC5C5\uBB34 \uC2DC\uAC04\uC5D0 \uB3D9\uD638\uD68C \uD65C\uB3D9 \uD558\uB290\uB77C
    \uAE30\uD68D\uC11C \uBC00\uB9AC\uBA74 \uD300\uC7A5\uB2D8\uD55C\uD14C \uD63C\uB098\uC9C0
    \uC54A\uC744\uAE4C\uC694\uB0E5\uB0E5?\""
  nextId02: 11103
