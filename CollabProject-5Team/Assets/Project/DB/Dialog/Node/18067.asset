    \uBED4\uD588\uC74C\uC694\u314B"
  choice01: "\uD300\uC7A5\uB2D8\uC774 \uC120\uC744 \uB118\uC73C\uC168\uB2E4\uB0E5\uB0E5!
    \uB0B4\uAC00 \uC0AC\uC7A5\uC2E4\uC5D0 \uB2E4\uC774\uB809\uD2B8\uB85C \uBCF4\uACE0\uD574\uC11C
    \uD300\uC7A5\uB2D8 \uACBD\uACE0 \uBA39\uC774\uACA0\uB2E4\uB0E5\uB0E5!"
  nextId01: 18068
  choice02: "\uD300\uC7A5\uB2D8 \uC131\uACA9\uC774 \uBD88\uAC19\uC544\uC11C \uADF8\uB807\uB2E4\uB0E5\uB0E5.
