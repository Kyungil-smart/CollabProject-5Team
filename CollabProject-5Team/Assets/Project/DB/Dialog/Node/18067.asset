  desc: "\uD3EC\uD0A4"
  text: "\uAE30\uC740 \uD300\uC7A5\uB2D8\uC774 \uC81C \uAE30\uD68D\uC11C \uBA74\uC804\uC5D0
    \uC9D1\uC5B4\uB358\uC9C0\uBA74\uC11C \uC774\uAC8C \uAE30\uD68D\uC11C\uB0D0\uB77C\uACE0
