  desc: "\uADFC\uC5C4 \uACE0\uC591\uC774"
  text: "\"\uB9C9\uB0B4 \uC790\uB124, \uB0B4\uAC00 \uC774\uBC88\uC5D0 \uC62C\uB9B0
    '\uC0AC\uB0B4 \uBCF5\uC9C0\uC6A9 \uCD5C\uACE0\uAE09 \uC218\uC785 \uC6D0\uBAA9
    \uC2A4\uD06C\uB798\uCC98 \uD488\uC758\uC11C' \uB9D0\uC774\uB2E4\uB0E5. \uC0AC\uC7A5\uB2D8\uC774
