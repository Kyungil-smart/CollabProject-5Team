  desc: "\uB124\uB85C"
  text: "\uD300\uC7A5\uB2D8\uC774 \uAD50\uBB18\uD558\uAC8C \uADC0\uCC2E\uACE0 \uD798\uB4E0
    \uD575\uC2EC \uC2DC\uC2A4\uD15C \uAE30\uD68D\uB9CC \uB098\uD55C\uD14C \uB2E4
    \uBAB0\uC544\uC8FC\uACE0, \uC9C0 \uB77C\uC778 \uD0C0\uB294 \uACE0\uC591\uC774\uD55C\uD14C\uB294
    \uAFC0 \uBE60\uB294 \uC5C5\uBB34\uB9CC \uC900\uB2E4\uB354\uB77C~. \uC774\uAC70
    \uC644\uBCBD\uD55C \uC0AC\uB0B4 \uC815\uCE58 \uC9C8\uC774\uB77C\uB354\uB77C~."
  choice01: "\uADF8\uB9CC\uD07C \uC120\uBC30\uB2D8 \uC2E4\uB825\uC744 \uBBFF\uACE0
    \uC758\uC9C0\uD558\uC2E0\uB2E4\uB294 \uC99D\uAC70 \uC544\uB2D0\uAE4C\uC694\uB0E5\uB0E5?"
  nextId01: 11312
  choice02: "\uC5B5\uC6B8\uD558\uC2DC\uBA74 \uC0AC\uC7A5\uB2D8 \uD56B\uB77C\uC778\uC774\uB098
