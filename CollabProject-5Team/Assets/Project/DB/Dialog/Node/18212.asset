  choice01: "\uC544\uD2B8 \uD300\uC7A5 \uC131\uACA9 \uAE4C\uCE60\uD574\uB3C4 \uB370\uC774\uD130
    \uC55E\uC5D4 \uC7A5\uC0AC \uC5C6\uB2E4\uB0E5\uB0E5. \uB0B4\uAC00 \uAC19\uC774
    \uAC00\uC8FC\uACA0\uB2E4\uB0E5\uB0E5!"
  nextId01: 18213
  choice02: "\uC57C\uB0E5\uB0E5, \uC544\uD2B8 \uD300 \uACE0\uC720 \uC601\uC5ED\uC778\uB370
