  desc: "\uBB49\uCE58"
  text: "\uC720\uC800\uB4E4\uC774 \uC5F4\uAD11\uD560 \uD669\uAE08 \uBE44\uC728\uC758
    \uCE90\uB9AD\uD130 \uCCB4\uD615 \uBD84\uC11D \uB370\uC774\uD130\uB97C \uC544\uD2B8
