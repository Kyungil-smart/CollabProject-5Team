  text: "\uC120\uBC30\uB2D8! \uD0D5\uBE44\uC2E4\uC5D0 \uC608\uC05C \uD654\uBD84\uC744
    \uD558\uB098 \uAC00\uC838\uB2E4 \uB1A8\uC5B4\uC694! \uC2DD\uBB3C\uB4E4\uC774
