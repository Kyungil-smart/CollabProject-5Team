  desc: "\uCD08\uCF54"
  text: "\"\uC81C \uC601\uD63C\uC774 \uB2F4\uAE34 \uBBF8\uACF5\uAC1C \uC804\uC124
    \uBB34\uAE30 \uC77C\uB7EC\uC2A4\uD2B8 \uD3F4\uB354 \uC2F9 \uB2E4 \uD3EC\uB9F7
    \uC2DC\uCF30\uC2B5\uB2C8\uB2E4. \uD68C\uC0AC\uAC00 \uC81C \uAC00\uCE58\uB97C
    \uBAA8\uB974\uB2C8 \uD30C\uAD34 \uD504\uB85C\uC138\uC2A4\uB97C \uB3CC\uB9B0 \uAC81\uB2C8\uB2E4.
    \uACE0\uC18C\uD558\uC2DC\uC8E0.\""
  choice01: "\uCD08\uCF54\uC57C!!! \uADF8\uAC78 \uC9C0\uC6B0\uBA74 \uC5B4\uB5A1\uD574\uB0E5\uB0E5!
    \uB124 \uC608\uC220\uD63C\uC774\uC790 \uC6B0\uB9AC \uD504\uB85C\uC81D\uD2B8\uC758
    \uC2EC\uC7A5\uC774\uB2E4\uB0E5\uB0E5! \uB2F9\uC7A5 \uBCF5\uAD6C \uD504\uB85C\uADF8\uB7A8
    \uAC00\uB3D9\uD574\uB77C\uB0E5\uB0E5!"
  nextId01: 19052
  choice02: "\uC804\uC0AC \uC790\uC0B0 \uD30C\uAD34 \uD589\uC704\uB2E4\uB0E5\uB0E5!
