  desc: "\uB8E8\uD53C"
  text: "\uD30C\uD2B8\uC7A5\uB2D8\uC774 \uC774\uBC88 \uC11C\uBE0C \uD018\uC2A4\uD2B8
    \uAE30\uD68D\uC548 '\uBE68\uB9AC \uC644\uC131\uD574!'\uB77C\uACE0 \uD558\uC168\uB294\uB370\uC6A9,
    \uC774\uAC74 \uADF8\uB0E5 \uB300\uCDA9 \uB300\uAC15 \uC2A4\uD53C\uB514\uD558\uAC8C
    \uBCF5\uC0AC \uBD99\uC5EC\uB123\uAE30 \uD558\uB77C\uB294 \uB73B\uC774\uACA0\uC8F5?"
  choice01: "\uB124, \uC18D\uB3C4\uAC00 \uC0DD\uBA85\uC774\uB2C8 \uD575\uC2EC \uAD6C\uC870\uB9CC
    \uBE60\uB974\uAC8C \uC7A1\uC544\uC11C \uB118\uAE41\uC2DC\uB2E4\uB0E5\uB0E5!"
  nextId01: 11652
  choice02: "\uC544\uBB34\uB9AC \uBE68\uB77C\uB3C4 \uD004\uB9AC\uD2F0\uAC00 \uBB34\uB108\uC9C0\uBA74
    \uBC18\uB824\uB2F9\uD569\uB2C8\uB2E4\uB0E5\uB0E5. \uC81C\uB300\uB85C \uD558\uC138\uC694\uB0E5\uB0E5."
  nextId02: 11653
