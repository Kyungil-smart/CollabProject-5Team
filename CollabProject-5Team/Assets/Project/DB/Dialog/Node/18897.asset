  choice01: "\u314B\u314B\u314B \uC0AC\uC7A5\uB2D8\uC774 \uC880 \uAF30\uB300\uB77C
    \uBBF8\uC548\uD558\uB2E4\uB0E5\uB0E5! \uB300\uC2E0 \uB0B4\uAC00 \uAC80\uC5F4
