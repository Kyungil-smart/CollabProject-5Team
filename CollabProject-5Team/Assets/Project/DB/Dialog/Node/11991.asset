  desc: "\uB8E8\uD53C \uC0AC\uC6D0"
  text: "\"\uB420 \uB300\uB85C \uB418\uB77C\uC9C0\uC6A9! \uC774\uBC88 \uC720\uB8CC\uD654
    \uBAA8\uB378\uC5D0 \uC720\uC800\uB4E4\uC774 \uBE61\uCE60 \uB9CC\uD55C \uC694\uC18C\uB97C
    \uB4EC\uBFCD \uB123\uC5B4\uC11C \uC0AC\uC7A5\uB2D8 \uC9C0\uAC11\uC774\uB098 \uB450\uB451\uD558\uAC8C
    \uB9CC\uB4E4\uC5B4 \uB4DC\uB9B4 \uAC70\uC608\uC6A9! \uB098\uB3C4 \uBAB0\uB77C\uC6A9!\""
  choice01: "\"\uC720\uC800 \uD3ED\uB3D9 \uC77C\uC5B4\uB098\uBA74 \uC6B0\uB9AC \uB458
    \uB2E4 \uD68C\uC0AC\uC5D0\uC11C \uC0B4\uC544\uB0A8\uC9C0 \uBABB\uD574\uC694!
    \uC815\uC2E0 \uCC28\uB9AC\uACE0 \uD61C\uC790 \uD328\uCE58\uB85C \uBC14\uAFC9\uC2DC\uB2E4!\""
  nextId01: 11992
  choice02: "\"\uC0AC\uC7A5\uB2D8\uC774 \uB3C8\uB3C5 \uC62C\uB790\uB2E4\uACE0 \uC720\uC800\uB4E4\uD55C\uD14C
    \uC695\uBA39\uC774\uACE0 \uC2F6\uC5B4\uC11C \uD658\uC7A5\uD588\uC2B5\uB2C8\uAE4C?
    \uAE30\uD68D \uB611\uBC14\uB85C \uD558\uC138\uC694.\""
