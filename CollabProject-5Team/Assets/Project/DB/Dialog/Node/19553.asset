  desc: "\uBBFC\uD2F0"
  text: "\uC81C \uC548\uC758 \uD558\uD2B8 \uC18C\uC6B8 \uC5D4\uC9C4\uC774 \uC644\uC804
    \uBC29\uC804 \uC18C\uBA78\uD588\uC2B5\uB2C8\uB2E4. \uC774\uC81C \uCEE8\uC149\uC9C8
