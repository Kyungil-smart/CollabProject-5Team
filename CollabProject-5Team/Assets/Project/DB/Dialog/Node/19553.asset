  choice01: "\uC548 \uB41C\uB2E4\uB0E5\uB0E5! \uB124 \uD0B9\uBC1B\uB294 \uBBFC\uCD08
    \uB9C8\uB825\uC774 \uC0AC\uB77C\uC9C0\uB2C8 \uB0B4 \uAC00\uC2B4\uC774 \uCC22\uC5B4\uC9C4\uB2E4\uB0E5\uB0E5!
