  desc: "\uCD08\uCF54"
  text: "\uC218\uC815 \uC694\uCCAD \uD14D\uC2A4\uD2B8\uB97C \uC77D\uB294 \uC21C\uAC04
    \uC81C \uD558\uD2B8\uAC00 \uCE68\uC2DD\uB418\uC5B4, \uAC15\uC81C \uB85C\uADF8\uC544\uC6C3
    \uD504\uB85C\uD1A0\uCF5C\uC774 \uAC00\uB3D9\uB418\uC5C8\uC2B5\uB2C8\uB2E4...
    \uD56D\uBA85\uC8C4\uB85C \uB2E4\uC2A4\uB9AC\uC2E4 \uAC74\uAC00\uC694?"
  choice01: "\uC0C1\uCC98 \uC92C\uB2E4\uBA74 \uBBF8\uC548\uD558\uB2E4\uB0E5\uB0E5!
    \uB124 \uC544\uD2B8\uB97C \uB354 \uB3CB\uBCF4\uC774\uAC8C \uD558\uB824\uACE0
    \uC0AC\uC7A5 \uB9C8\uC778\uB4DC\uB85C \uACE0\uC2EC\uD558\uB2E4 \uADF8\uB7AC\uB2E4\uB0E5\uB0E5!"
  nextId01: 18882
  choice02: "\uC5C5\uBB34 \uD53C\uB4DC\uBC31\uC744 \uC77D\uC539\uD558\uB294 \uAC74
