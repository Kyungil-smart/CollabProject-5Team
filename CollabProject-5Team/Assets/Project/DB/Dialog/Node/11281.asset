  desc: "\uB124\uB85C"
  text: "\uC6B0\uB9AC \uC0AC\uBB34\uC2E4 \uCC9C\uC7A5\uC5D0 \uB2EC\uB9B0 CCTV \uB9D0\uC774\uB77C\uB354\uB77C~.
    \uADF8\uAC70 \uBCF4\uC548\uC6A9\uC774 \uC544\uB2C8\uB77C \uC0AC\uC7A5\uC2E4 \uBAA8\uB2C8\uD130\uB85C
    \uC5F0\uACB0\uB3FC\uC11C \uC9C1\uC6D0\uB4E4 \uB534\uC9D3\uD558\uB098 \uC2E4\uC2DC\uAC04
    \uAC10\uC2DC\uC6A9\uC774\uB77C\uB294 \uC18C\uBB38\uC774 \uC788\uB2E4\uB354\uB77C~.
    \uBB34\uC11C\uC6CC\uC11C \uD654\uC7A5\uC2E4\uB3C4 \uB208\uCE58 \uBCF4\uBA70 \uAC04\uB2E4\uB354\uB77C~."
  choice01: "\uC5D0\uC774, \uAC1C\uC778\uC815\uBCF4\uBCF4\uD638\uBC95\uC774 \uC5C4\uACA9\uD55C\uB370
