  choice01: "\uC120\uBC30\uB2D8, \uC720\uAE09 \uBCD1\uAC00 \uD734\uC9C1 \uC2E0\uCCAD\uC11C
    \uC591\uC2DD \uC81C\uAC00 \uC368\uB4DC\uB9B4 \uD14C\uB2C8 \uD55C \uB2EC\uB9CC
