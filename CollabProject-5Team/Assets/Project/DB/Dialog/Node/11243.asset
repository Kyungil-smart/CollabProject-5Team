  desc: "\uB124\uB85C \uC0AC\uC6D0"
  text: "\"\uB0B4 \uB9D0\uC774 \uADF8 \uB9D0\uC774\uB77C\uB354\uB77C~! \uC0AC\uC7A5\uB2D8\uC774
