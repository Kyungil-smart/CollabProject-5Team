  nextId01: 11244
  choice02: "\"\uC77C\uC815\uACFC \uB9AC\uC18C\uC2A4 \uBB38\uC81C\uC0C1 \uC0AC\uC7A5\uB2D8\uC73C\uB85C\uC11C\uB3C4
