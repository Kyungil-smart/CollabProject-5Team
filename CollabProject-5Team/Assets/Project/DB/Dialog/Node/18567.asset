  choice01: "\u314B\u314B\u314B \uADF8 \uCC98\uC9C4 \uC785\uBAA8\uC591 \uC5B5\uC6B8\uD574
    \uBCF4\uC5EC\uC11C \uB108\uBB34 \uADC0\uC5FD\uB2E4\uB0E5\uB0E5! \uC624\uB298
    \uC5C5\uBB34 \uB2E4 \uC62C \uC2A4\uD1B1\uD558\uACE0 \uB0B4 \uC9C0\uAC11\uC73C\uB85C
