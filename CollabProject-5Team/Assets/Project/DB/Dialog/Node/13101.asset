    \uBCFC\uAC8C\uC694\uB0E5."
  nextId01: 13102
  choice02: "\uCD5C\uC801\uD654\uAC00 \uC548 \uB418\uBA74 \uAC8C\uC784\uC774 \uB04A\uAE41\uB2C8\uB2E4\uB0E5.
