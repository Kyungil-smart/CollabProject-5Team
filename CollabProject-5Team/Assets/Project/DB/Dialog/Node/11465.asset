  desc: "\uB124\uB85C \uC0AC\uC6D0"
  text: "\"\uC0AC\uC7A5 \uADF8 \uC778\uAC04\uC740 \uC9C1\uC6D0\uB4E4\uC744 \uAC10\uC2DC\uD558\uB294
