  nextId01: 11481
  choice02: "\"\uC6B0\uC640, \uB178\uB3D9\uC870\uD569 \uC704\uC6D0\uC7A5\uB2D8 \uBA4B\uC9C0\uC2ED\uB2C8\uB2E4\uB0E5\uB0E5!
