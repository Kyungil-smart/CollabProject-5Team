  choice01: "\uC624, \uACBD\uC7C1\uC0AC \uC644\uBCBD \uBD84\uC11D \uCE74\uD53C\uCEA3
    \uC804\uB7B5\uC774\uB0D0\uB0E5\uB0E5? \uCC38\uC2E0\uD558\uB124\uB0E5\uB0E5! \uB300\uC2E0
