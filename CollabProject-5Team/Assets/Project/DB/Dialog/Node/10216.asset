  desc: "\uCFE0\uD0A4"
  text: "\uAE30\uD68D\uD300 \uB140\uC11D\uB4E4\uC774 \uAC8C\uC784 \uBCFC\uB968 \uD0A4\uC6B4\uB2F5\uC2DC\uACE0
    \uB0B4\uAC00 \uC815\uC131\uAECF \uCD5C\uC801\uD654\uD55C \uBA54\uBAA8\uB9AC \uAD6C\uC870\uB97C
    \uC5B5\uC9C0\uB85C \uD130\uB728\uB824\uBC84\uB838\uAD70\uC694! \uB809 \uAC78\uB9AC\uB294
    \uAC78 \uBCF4\uB2C8 \uAC00\uC2B4\uC774 \uCC22\uC5B4\uC9C8 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4...
    \uB098 \uC77C \uC548 \uD558\uB835\uB2C8\uB2E4! \uD760\uD760\uB0E5."
  choice01: "\uBA54\uBAA8\uB9AC\uB97C \uB35C \uBA39\uC73C\uBA74\uC11C \uC131\uB2A5\uC744
    \uBCF4\uC874\uD558\uB294 \uC0C8\uB85C\uC6B4 \uCE90\uC2F1 \uAE30\uBC95\uC744 \uC81C\uAC00
    \uC54C\uC544\uC654\uC2B5\uB2C8\uB2E4\uB0E5\uB0E5! \uAE30\uD68D\uD300\uC774\uB791
    \uD569\uC758 \uBCF4\uC2DC\uC8E0\uB0E5\uB0E5!"
  nextId01: 10217
  choice02: "\uCEE8\uD150\uCE20\uAC00 \uC5C6\uB294 \uAC83\uBCF4\uB2E4\uB294 \uB0AB\uC8E0\uB0E5\uB0E5.
    \uC720\uC800\uB4E4\uC740 \uBA54\uBAA8\uB9AC \uAD6C\uC870 \uADF8\uB807\uAC8C \uC790\uC138\uD788
