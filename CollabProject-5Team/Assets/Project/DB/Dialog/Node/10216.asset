  desc: "\uADFC\uC5C4 \uACE0\uC591\uC774"
  text: "\"\uAC1C\uBC1C\uD300 \uB140\uC11D\uB4E4\uC774 \uCD5C\uC801\uD654\uD55C\uB2F5\uC2DC\uACE0
