  desc: "\uB124\uB85C"
  text: "\uC2E0\uC785, \uBC29\uAE08 \uD504\uB85C\uADF8\uB7A8 \uD300\uC7A5 \uBC29
    \uC9C0\uB098\uAC00\uB294\uB370 \uB0B4 \uAE30\uD68D\uC11C \uBCF4\uACE0 \uC774\uB534
    \uC2DD\uC73C\uB85C \uC9DC\uC624\uBA74 \uAD6C\uD604 \uBABB \uD55C\uB2E4\uACE0
    \uB300\uB193\uACE0 \uBE44\uC6C3\uB294 \uAC78 \uB4E4\uC5C8\uB2E4\uB354\uB77C~.
    \uAE30\uD68D\uC790\uB97C \uADF8\uB0E5 \uBB38\uC7A5 \uC791\uC131\uAE30 \uCDE8\uAE09\uD558\uB294
    \uAC8C \uB108\uBB34 \uBAA8\uC695\uC801\uC774\uB77C\uB354\uB77C~."
  choice01: "\uAC10\uD788 \uC120\uBC30\uB2D8 \uAE30\uD68D\uC744 \uBAA8\uC695\uD558\uB2E4\uB2C8\uC694\uB0E5\uB0E5!
    \uC81C\uAC00 \uAC00\uC11C \uAE30\uC220\uC801 \uB17C\uB9AC\uB85C \uD329\uD2B8
    \uD3ED\uD589\uD558\uACE0 \uC624\uACA0\uC2B5\uB2C8\uB2E4\uB0E5\uB0E5!"
  nextId01: 11267
  choice02: "\uAC1C\uBC1C\uC790\uBD84\uB4E4\uC774 \uAD6C\uD604 \uB09C\uC774\uB3C4
    \uB54C\uBB38\uC5D0 \uC608\uBBFC\uD574\uC11C \uADF8\uB7F0 \uAC78 \uD14C\uB2C8,
    \uC6B0\uB9AC\uAC00 \uAD6C\uC870\uB97C \uC880 \uC27D\uAC8C \uB2E4\uB4EC\uC5B4
    \uC8FC\uC8E0\uB0E5\uB0E5."
  nextId02: 11269
