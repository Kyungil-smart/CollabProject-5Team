  desc: "\uB124\uB85C"
  text: "\uC774\uBC88\uC5D0 \uBCF5\uC9C0 \uD3EC\uC778\uD2B8 \uC81C\uB3C4\uAC00 \uAC1C\uD3B8\uB418\uBA74\uC11C
    \uADFC\uC18D\uC5F0\uC218 \uAE38\uACE0 \uC9C1\uAE09 \uB192\uC740 \uC784\uC6D0\uB4E4\uB9CC
    \uC655\uCC3D \uD37C\uC8FC\uACE0, \uC6B0\uB9AC \uAC19\uC740 \uC2E4\uBB34\uC790
    \uD3EC\uC778\uD2B8\uB97C \uAE4E\uC544\uBC84\uB838\uB2E4\uB354\uB77C~. \uC0AC\uC7A5\uB2D8\uC774
    \uB300\uAE30\uC5C5 \uC545\uC2B5\uB9CC \uC3D9 \uBE7C\uB2EE\uC558\uB2E4\uB354\uB77C~."
  choice01: "\uC7A5\uAE30 \uADFC\uC18D\uC790\uC5D0 \uB300\uD55C \uC608\uC6B0\uB3C4
    \uC911\uC694\uD558\uC8E0\uB0E5\uB0E5. \uC6B0\uB9AC\uB3C4 \uC624\uB798 \uBC84\uD2F0\uBA74
    \uADF8\uB9CC\uD07C \uD61C\uD0DD\uC744 \uBC1B\uC744 \uAC81\uB2C8\uB2E4\uB0E5\uB0E5!"
  nextId01: 11287
  choice02: "\uC2E4\uBB34\uC9C4\uC774 \uACE0\uC0DD\uC740 \uB2E4 \uD558\uB294\uB370
    \uBCF5\uC9C0\uB97C \uAE4E\uB2E4\uB2C8 \uB108\uBB34\uD558\uB124\uC694\uB0E5\uB0E5.
    \uC0AC\uC7A5\uB2D8 \uB108\uBB34\uD558\uC2ED\uB2C8\uB2E4\uB0E5\uB0E5!"
