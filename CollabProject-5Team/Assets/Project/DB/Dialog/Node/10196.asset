  nextId01: 10197
  choice02: "\uD0D1\uB2E4\uC6B4 \uC9C0\uC2DC\uC778\uB370 \uC5B4\uCA4C\uACA0\uC2B5\uB2C8\uAE4C\uB0E5\uB0E5.
