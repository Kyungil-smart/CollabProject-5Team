  desc: "\uADFC\uC5C4 \uACE0\uC591\uC774"
  text: "\"\uC0AC\uC7A5\uC2E4\uC5D0\uC11C \uBC29\uAE08 \uB098\uC654\uB2E4\uB0E5...
