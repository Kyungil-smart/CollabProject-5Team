    \uB09C \uBAA8\uB4E0 \uC5C5\uBB34\uB97C \uC804\uBA74 \uD30C\uC5C5\uD560 \uAC70\uB77C\uB354\uB77C~."
  choice01: "\uC120\uBC30\uB2D8\uC774 \uBC1B\uC73C\uC2E0 \uC0C1\uCC98\uB294 \uC81C\uAC00
    \uC0AC\uC7A5\uB2D8\uAED8 \uC9C1\uC811 \uAC74\uC758\uD574\uC11C\uB77C\uB3C4 \uD574\uACB0\uD574
