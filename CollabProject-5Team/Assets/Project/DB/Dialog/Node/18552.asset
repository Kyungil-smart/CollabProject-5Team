  desc: "\uBB49\uCE58"
  text: "\uACF5\uC2DD \uCE74\uD398\uC5D0 \uBC84\uADF8 \uC9C0\uD45C \uD130\uC838\uC11C
    \uB09C\uB9AC \uB0AC\uB294\uB370... \uC5B4\uCC28\uD53C \uC81C \uC54C \uBC14 \uC544\uB2D9\uB2C8\uB2E4...
    \uC720\uC800\uB4E4\uC774 \uBD88\uD0C0\uC8FD\uB4E0 \uB9D0\uB4E0 \uC81C \uBA58\uD0C8\uC774
    \uBA3C\uC800 \uD0C0\uBC84\uB838\uB294\uB370... \uC790\uB974\uB358\uAC00\uC694\u314B...
    \uC544\uB2C8 \uC2DC\uBB34\uB8E9..."
  choice01: "\uD3EC\uD0A4\uC57C... \uC544\uB2C8 \uBB49\uCE58\uC57C! \uB124\uAC00
    \uC124\uACC4\uD55C \uCDE8\uD5A5 \uC800\uACA9 \uCF54\uB4DC\uB85C \uC720\uC800\uB4E4
    \uC9C4\uD654\uD560 \uC0AC\uB78C\uC740 \uB108\uBFD0\uC774\uB2E4\uB0E5\uB0E5! \uB098
    \uC880 \uC0B4\uB824\uC918\uB77C\uB0E5\uB0E5!"
  nextId01: 18553
  choice02: "\uD504\uB85C \uAE30\uD68D\uC790\uAC00 \uB77C\uC774\uBE0C \uD130\uC84C\uB294\uB370
