  desc: "\uB8E8\uD53C"
  text: "\uD30C\uD2B8\uC7A5\uB2D8\uC774 \uB370\uC774\uD130 \uBD84\uC11D \uD234 \uC4F0\uB294
    \uBC95 \uBC30\uC6B0\uB77C\uB294\uB370, \uC601\uC5B4\uAC00 \uB108\uBB34 \uB9CE\uACE0
    \uD074\uB9AD\uD560 \uAC8C \uB9CE\uC544\uC11C \uBA38\uB9AC\uAC00 \uC544\uD30C\uC6A9.
    \uC800\uB294 \uC5ED\uC2DC \uAC10\uAC01 \uD30C\uC778\uAC00 \uBD10\uC6A9..."
  choice01: "\uCC98\uC74C\uC5D4 \uB2E4\uB0E5\uB0E5 \uC5B4\uB824\uC6CC\uC694\uB0E5\uB0E5.
    \uC81C\uAC00 \uC790\uC8FC \uC4F0\uB294 \uAE30\uB2A5 \uC704\uC8FC\uB85C \uC27D\uAC8C
    \uC54C\uB824\uB4DC\uB9B4\uAC8C\uC694\uB0E5\uB0E5!"
  nextId01: 11822
  choice02: "\uB370\uC774\uD130 \uD234\uB3C4 \uBABB \uC4F0\uBA74 \uAE30\uD68D\uC790\uB85C\uC11C
    \uB3C4\uD0DC\uB429\uB2C8\uB2E4\uB0E5\uB0E5. \uB9C1\uD06C \uBCF4\uB0BC \uD14C\uB2C8
