  desc: "\uB124\uB85C \uC0AC\uC6D0"
  text: "\"\uC624\uB298 \uC624\uD6C4\uC5D0 \uC0AC\uC7A5\uB2D8\uC774 \uBD88\uC2DC\uC5D0
    \uAE30\uD68D\uC2E4 \uC810\uAC80\uD558\uB7EC \uB0B4\uB824\uC628\uB2E4\uB294 \uC815\uBCF4\uAC00
