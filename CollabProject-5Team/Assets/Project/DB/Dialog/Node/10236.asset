  nextId01: 10237
  choice02: "\uB9C8\uC9C0\uB9C9 \uBE4C\uB4DC \uB9C8\uAC10 \uC8FC\uAC04\uC785\uB2C8\uB2E4\uB0E5\uB0E5!
